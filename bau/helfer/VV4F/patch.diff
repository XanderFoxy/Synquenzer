+}
+function mtrPaint(m, f) {   // f = [peak, rms, hold, led] linear; only changed values are written
+  const s = m._st, hz = m.classList.contains('hz');
+  const r = Math.round(mtrFrac(f[1]) * 100), p = Math.round(mtrFrac(f[0]) * 100), h = Math.round(mtrFrac(f[2]) * 100), l = f[3] ? 1 : 0;
+  const ins = v => (hz ? 'inset(0 ' + (100 - v) + '% 0 0)' : 'inset(' + (100 - v) + '% 0 0 0)');
+  if (r !== s.r) { s.r = r; const st = m.firstChild.children[1].style; st.clipPath = st.webkitClipPath = ins(r); }
+  if (p !== s.p) { s.p = p; const st = m.firstChild.children[0].style; st.clipPath = st.webkitClipPath = ins(p); }
+  if (h !== s.h) { s.h = h; const e = m.firstChild.children[2]; e.style[hz ? 'left' : 'bottom'] = 'calc(' + h + '% - ' + (h ? 1 : 0) + 'px)'; e.style.opacity = h ? 1 : 0; }
+  if (l !== s.l) { s.l = l; m.classList.toggle('clip', !!l); }
+}
+// on screen and not covered (checked ≤ 4× per second): the master button or a track meter is hit-tested at its centre
+function mtrVisible() {
+  if (document.hidden) return false;
+  const row = UI.songView ? (SV.labs && SV.labs.querySelector('.sv-l.trk:not(.blank)')) : ((UI.heads.find(h => h && h.mt && h.el.offsetParent) || {}).el);
