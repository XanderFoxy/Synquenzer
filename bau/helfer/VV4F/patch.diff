+/* ---------- VV4-F „Mäusekino“: Pegel je Spur + Master (Konzept Schnitt/Video §2.2 VV4-F, Abnahme VV4-11/12) ----------
+   Ein Meter-Worklet (synq-meter, im selben Modul wie der Synth) für alle Spuren: Eingang i = Spur i nach dem Fader (N.cut),
+   Eingang MAX_T = Master-Ausgang (AU.M.ceil). ≈ 30 Hz Spitze/RMS; der Hauptthread legt die Werte nur in einen Ring und zeichnet
+   im vorhandenen rAF (nur geänderte Werte). Aus bei verdeckter Anzeige oder CPU-Begrenzer ≥ 2. Messen ändert den Klang nicht
+   (reine Abzweigung; der stumme Ausgang des Meters geht an destination, damit WebKit/Chromium ihn sicher rechnen). */
+const MTR_IN = MAX_T + 1, MTR_W = 1 + 2 * MTR_IN, MTR_HOLD = 1.5, MTR_LED = Math.pow(10, -.3 / 20), MTR_FLOOR = -48;
+const MTR = {want: false, chkT: 0, vis: false, els: [], master: [], disp: new Float32Array(MTR_IN * 4), drawn: [], frames: 0, on: false};
+// a time-ordered store of meter windows (live: ring of cap windows; video: all windows of the render)
+function mtrStore(cap) { return {cap, t: new Float64Array(cap), v: new Float32Array(cap * MTR_W), cnt: 0, seq: 0, lost: 0}; }
+function mtrPut(Q, a, seq, n) {
+  for (let w = 0; w < (n || 1); w++) { const j = Q.cnt % Q.cap; Q.t[j] = a[w * MTR_W]; Q.v.set(a.subarray(w * MTR_W, (w + 1) * MTR_W), j * MTR_W); Q.cnt++; }
+  if (seq != null) { if (Q.seq && seq !== Q.seq + 1) Q.lost += Math.max(0, seq - Q.seq - 1); Q.seq = seq; }
+}
+// the newest window that ends at or before τ (logical index) or -1
+function mtrFind(Q, tau) {
+  let lo = Math.max(0, Q.cnt - Q.cap), hi = Q.cnt - 1;
+  if (hi < lo || Q.t[lo % Q.cap] > tau) return -1;
+  if (Q.t[hi % Q.cap] <= tau) return hi;
+  while (hi - lo > 1) { const m = (lo + hi) >> 1; if (Q.t[m % Q.cap] <= tau) lo = m; else hi = m; }
+  return lo;
+}
+const mtrDb = x => (x > 1e-6 ? 20 * Math.log10(x) : -120);
+// input k at time τ: [peak, rms, hold (max peak of the last 1.5 s), led (1 = a peak over −0.3 dBFS in the last 1.5 s)].
+// span = 0: the newest window (live, ≈ 32 ms); span > 0: all windows ending in (τ − span, τ] together (video: one picture)
+function mtrAt(Q, tau, k, o, oi, span) {
+  o[oi] = o[oi + 1] = o[oi + 2] = o[oi + 3] = 0;
+  const j = mtrFind(Q, tau); if (j < 0 || tau - Q.t[j % Q.cap] > .25) return o;    // nothing measured near τ (stopped meter): empty
+  let h = 0, pk = 0, ss = 0, m = 0; const lo = Math.max(0, Q.cnt - Q.cap), c = 1 + 2 * k, lim = tau - (span || 0) + 1e-9;
+  for (let x = j; x >= lo; x--) {
+    const q = x % Q.cap, tx = Q.t[q]; if (tx <= tau - MTR_HOLD) break;
+    const p = Q.v[q * MTR_W + c]; if (p > h) h = p;
+    if (!m || tx > lim) { const r = Q.v[q * MTR_W + c + 1]; ss += r * r; m++; if (p > pk) pk = p; }
+  }
+  o[oi] = pk; o[oi + 1] = Math.sqrt(ss / Math.max(1, m)); o[oi + 2] = h; o[oi + 3] = h > MTR_LED ? 1 : 0;
+  return o;
+}
+const mtrFrac = x => { const d = mtrDb(x); return d <= MTR_FLOOR ? 0 : d >= 0 ? 1 : (d - MTR_FLOOR) / -MTR_FLOOR; };
+// builds the meter on the current context (live after the worklet loaded; the offline render in vvSwapIn). off = the video job
+function mtrBuild(off) {
+  const c = AU.ctx; if (!c || AU.meter || typeof AudioWorkletNode !== 'function') return null;
+  if (!off && SynthHost.state !== 'ready') return null;
+  let node;
+  try {
+    node = new AudioWorkletNode(c, 'synq-meter', {numberOfInputs: MTR_IN, numberOfOutputs: 1, outputChannelCount: [1], channelCount: 2,
+      channelCountMode: 'explicit', channelInterpretation: 'speakers', processorOptions: off ? {on: true, win: 1, batch: 16, total: c.length} : {on: MTR.on}});
+  } catch (e) { logErr(e); return null; }
+  const M = AU.meter = {node, ctx: c, tap: [], off: !!off, Q: off ? mtrStore(Math.ceil(c.length / 128) + 8) : mtrStore(160)};
+  node.port.onmessage = e => { const m = e.data; if (m && m.mtr) mtrPut(M.Q, m.mtr, m.seq, m.n); };
+  node.connect(c.destination);
+  for (let i = 0; i < NT(); i++) mtrTap(i);
+  try { if (AU.M && AU.M.ceil) AU.M.ceil.connect(node, 0, MAX_T); } catch (e) { logErr(e); }
+  return M;
+}
+function mtrTap(i) {
+  const M = AU.meter, A = AU.tracks[i]; if (!M || !A || !A.cut || A.cut.context !== M.ctx) return;
+  const old = M.tap[i]; if (old === A.cut) return;
+  if (old) { try { old.disconnect(M.node, 0, i); } catch (e) {} }
+  try { A.cut.connect(M.node, 0, i); M.tap[i] = A.cut; } catch (e) { logErr(e); }
+}
+function mtrSend(on) { MTR.on = on; const M = AU.meter; if (M && !M.off) { try { M.node.port.postMessage({on}); } catch (e) {} } }
+// the elements: one per track head (matrix) and song label, the master in the matrix corner and in the TAKT cell of the song
+function mtrEl(cls) { const m = el('span', 'mtr' + (cls ? ' ' + cls : ''), '<span class="mb"><b class="p"></b><b class="r"></b><i class="h"></i></span><i class="l"></i>'); m.setAttribute('aria-hidden', 'true'); m._st = {r: -1, p: -1, h: -1, l: -1}; return m; }
+function mtrMasterBtn(where) {
+  const b = el('button', 'mtrm mtrm-' + where); b.setAttribute('aria-label', 'Master-Pegel – MASTER-Seite öffnen'); b.title = 'Master-Pegel (antippen: MASTER)';
+  b.appendChild(mtrEl(where === 'sv' ? 'hz' : '')); guardTouch(b);
+  b.addEventListener('pointerdown', e => e.stopPropagation());       // never a grid / song gesture
+  onTap(b, () => { haptic('tick'); openMasterPage(); });
+  return b;
+}
+// Tipp auf den Master-Balken: der Klang-Editor der gewählten Spur auf FX › MASTER (Drums: FX › MASTER des Drum-Editors)
+function openMasterPage() {
+  let i = R.selT; if (!S.tracks[i] || S.tracks[i].stimme) { const k = trackOrder().find(t => S.tracks[t] && !S.tracks[t].stimme); if (k == null) return false; selectTrack(k); i = k; }
