+}
+function mtrFrame() {
+  const M = AU.meter, P0 = performance.now();
+  if (!M || M.off) { if (MTR.vis) mtrBlank(); return; }
+  if (LIM.level >= 2) { if (MTR.on) { mtrSend(false); mtrBlank(); } return; }       // CPU-Begrenzer ≥ 2: aus (0 ms)
