+    st = 'asking';
+    const pr = e => { if (fin(e.beta) && fin(e.gamma)) { done(); setSt('ok'); } };
+    const done = () => { clearTimeout(probeT); window.removeEventListener('deviceorientation', pr); nList--; };
+    window.addEventListener('deviceorientation', pr); nList++;
