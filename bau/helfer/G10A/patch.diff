+  else delete p.ear;
+}
+const g10aEarOn = () => { const p = stProf().prof.speaker; return !!(p && p.ear); };
+const g10aSpeakerLbl = () => (g10aEarOn() ? '🔈 Hörmuschel?' : '🔈 Lautsprecher');
+const g10aEarHTML = rt => (rt === 'speaker' && g10aEarOn() ? '<div class="g10a-ear">Musik leise aus der Hörmuschel – Kabel-Kopfhörer einstecken</div>' : '');
+
+/* ---------- 2. Gesang beim ersten Song-Durchgang ---------- */
+const g10aVoxReady = () => !!(ST.on && ST.phase !== 'off' && ST.phase !== 'start' && tkAudioOk() && ST.ring);
+function g10aSongVoxBegin(sr) {
+  if (!sr || sr.over || sr.vox || !g10aVoxReady() || !AU.ctx) return false;
+  sr.vox = {passes: [{a: 0, T: sr.startBeat}]}; sr.g10a = true;
+  tkQ('song', true);
