+}
+function g10aSongVoxDrop(sr) { if (sr && sr.g10a && sr.vox) { sr.vox = null; try { g8Drop(); } catch (e) { logErr(e); } } }
+function g10aSongVoxCommit(sr, song) {
+  if (!sr || !sr.g10a || !sr.vox || !song) return false;
+  sr.mode = 'over'; sr.from = 0;
+  try { tkSongCommit(sr, song.bars, 0); } catch (e) { logErr(e); }
