+function sx4SoloLive() {
+  if (!SX4.solo.size || !AU.ctx) return false;
+  for (const t of [...SX4.solo]) if (!S.tracks.includes(t)) SX4.solo.delete(t);          // anderes Projekt, Spur entfernt
+  if (!SX4.solo.size) return false;
+  const OAC = window.OfflineAudioContext || window.webkitOfflineAudioContext;
+  if (OAC && AU.ctx instanceof OAC) return false;
+  return !(typeof SREC !== 'undefined' && SREC.on);
+}
+const sx4IsSolo = i => !!(S.tracks[i] && SX4.solo.has(S.tracks[i]));
+const sx4Pass = i => !sx4SoloLive() || sx4IsSolo(i);
+// alle Spur-Gains (+ Chor-Gruppe) auf den Solo-Stand; ≈ 15-ms-Rampe, kein Klick
+function sx4SoloApply() {
+  const c = AU.ctx; if (!c) return;
+  const now = c.currentTime;
+  for (let i = 0; i < NT(); i++) {
+    const A = AU.tracks[i]; if (!A || !A.sx4 || A.sx4.context !== c) continue;
+    const g = A.sx4.gain, v = sx4Pass(i) ? 1 : 0;
+    try { g.cancelScheduledValues(now); g.setValueAtTime(g.value, now); g.setTargetAtTime(v, now, .005); g.setValueAtTime(v, now + .06); } catch (e) { g.value = v; }
+  }
+  if (stimmeT() >= 0 && typeof g6pcApplyAll === 'function') { try { g6pcApplyAll(); } catch (e) { logErr(e); } }
