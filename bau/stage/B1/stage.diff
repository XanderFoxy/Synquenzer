+    const x = mapX(H.xRef, H.ths), ch = x !== H.x; H.x = x;
+    if (ch && t - H.tSend >= SEND_MS - .5) { H.tSend = t; send('move'); }
+  }
+  function tick() {
+    if (!H.on || !H.refOk) return;
+    if (scrAngle() !== H.ang) { holdEnd(); return; }
