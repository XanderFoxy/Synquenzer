+/* ======================================================================================================================
+   synq-meter (VV4-F Maeusekino): ONE meter for all tracks + master. Inputs 0..n-2 = the tracks (post fader, N.cut),
+   input n-1 = the master output. Every win blocks (about 30 Hz) it posts [t, peak0, rms0, peak1, rms1, ...] (t = context
+   time at the end of the window). Measures only: the output stays silent, the taps are plain fan-outs (sound unchanged).
+   The offline render (video) uses win 1 (one window per 128 frames) and sends batch windows per message; the last block of
+   total frames sends what is left. No allocation in process(): the message object and its Float32Array are made once
+   (postMessage copies them).
+   {on: false} stops all work (hidden display, CPU limiter level >= 2); {dispose: true} ends the processor.
+   ====================================================================================================================== */
+class SynqMeter extends AudioWorkletProcessor {
+  constructor(o) {
+    super();
+    const p = (o && o.processorOptions) || {};
+    this.n = Math.max(1, (o && o.numberOfInputs) | 0);
+    this.win = Math.max(1, p.win | 0 || Math.round(sampleRate / 30 / 128));
+    this.pk = new Float32Array(this.n); this.sq = new Float64Array(this.n);
+    this.W = 1 + 2 * this.n; this.batch = Math.max(1, p.batch | 0 || 1); this.total = +p.total || 0;
+    this.out = new Float32Array(this.batch * this.W); this.msg = {mtr: this.out, seq: 0, n: 0}; this.bi = 0;
+    this.k = 0; this.on = p.on !== false; this.alive = true;
+    this.port.onmessage = e => {
+      const m = e.data; if (!m) return;
+      if (m.on != null) { this.on = !!m.on; this.k = 0; this.bi = 0; this.pk.fill(0); this.sq.fill(0); }
+      if (m.dispose) this.alive = false;
+    };
+  }
+  process(inputs) {
+    if (!this.on) return this.alive;
+    const n = this.n, pk = this.pk, sq = this.sq;
+    for (let k = 0; k < n; k++) {
+      const chs = inputs[k], nc = chs ? chs.length : 0; if (!nc) continue;
+      let p = pk[k], s = 0;
+      for (let c = 0; c < nc; c++) {
+        const d = chs[c], L = d.length;
+        for (let i = 0; i < L; i++) { const x = d[i], a = x < 0 ? -x : x; if (a > p) p = a; s += x * x; }
+      }
+      pk[k] = p; sq[k] += s / nc;
+    }
+    if (++this.k >= this.win) {
+      const out = this.out, N = this.win * 128, o = this.bi * this.W;
+      out[o] = currentTime + 128 / sampleRate;
+      for (let k = 0; k < n; k++) { const r = Math.sqrt(sq[k] / N), p = pk[k]; out[o + 1 + 2 * k] = p >= 0 && p < 1e9 ? p : 0; out[o + 2 + 2 * k] = r >= 0 && r < 1e9 ? r : 0; pk[k] = 0; sq[k] = 0; }
+      this.k = 0;
+      if (++this.bi >= this.batch || (this.total && currentFrame + 128 >= this.total)) { this.msg.n = this.bi; this.msg.seq++; this.port.postMessage(this.msg); this.bi = 0; }
+    }
+    return this.alive;
+  }
+}
