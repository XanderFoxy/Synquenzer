{"format":1,"id":"einschlafen","kurz":"es","sprache":"it","richtung":"ltr","titel":"Ritrovare la calma a letto","untertitel":"Mettere da parte la giornata, sciogliere i muscoli, espirare lentamente. La voce si fa più bassa e finisce senza suono.","haltung":["im_bett"],"augen":"zu_oder_offen","ende":"still","schlaf_modus":false,"laengen":{"kurz":{"ziel_s":480},"normal":{"ziel_s":900},"lang":{"ziel_s":1500}},"kb":693,"abschnitte":[{"id":"ankommen","segmente":[{"id":"s001","art":"sprache","datei":"es/1.dafda863.mp3","ms":5521,"text":"Mettiti nella posizione in cui di solito ti addormenti. Spegni la luce.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s002","art":"sprache","datei":"es/2.c8dfee8c.mp3","ms":4056,"text":"Metti giù il telefono, in modo da non guardare più lo schermo.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s003","art":"sprache","datei":"es/3.4752aba6.mp3","ms":11072,"text":"Ora non devi più fare niente. Nemmeno addormentarti. Puoi semplicemente riposare. E puoi interrompere in qualsiasi momento.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}}]},{"id":"ablegen","segmente":[{"id":"s004","art":"sprache","datei":"es/4.eee8209b.mp3","ms":6428,"text":"Hai ancora in testa cose per domani? Immagina di metterle in una scatola accanto al letto.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"s005","art":"sprache","datei":"es/5.94790a36.mp3","ms":1997,"text":"Domani potrai riprenderle.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"s006","art":"sprache","datei":"es/6.ef6fc517.mp3","ms":4839,"text":"Se qualcosa continua a girarti in testa, puoi anche annotarlo brevemente.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}}]},{"id":"muskeln","segmente":[{"id":"s007","art":"sprache","datei":"es/7.a7348527.mp3","ms":4768,"text":"Stringi le mani a pugno per un momento. Molto leggermente.","in":["kurz","normal","lang"],"pause_s":{"kurz":4,"normal":4,"lang":4},"pause_fest":true},{"id":"s008","art":"sprache","datei":"es/8.0fa7c1ac.mp3","ms":1122,"text":"E lascia andare.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s009","art":"sprache","datei":"es/9.0d257fd9.mp3","ms":2644,"text":"Solleva un po' le spalle verso le orecchie.","in":["kurz","normal","lang"],"pause_s":{"kurz":4,"normal":4,"lang":4},"pause_fest":true},{"id":"s010","art":"sprache","datei":"es/10.5d095aa6.mp3","ms":1346,"text":"E lasciale scendere.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s011","art":"sprache","datei":"es/11.2556abdf.mp3","ms":2317,"text":"Stringi un po' i muscoli del viso.","in":["normal","lang"],"pause_s":{"normal":4,"lang":4},"pause_fest":true},{"id":"s012","art":"sprache","datei":"es/12.a3a59774.mp3","ms":1852,"text":"E lascia che si ammorbidisca.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"s013","art":"sprache","datei":"es/13.7a912349.mp3","ms":2877,"text":"Senti come i muscoli ora sono più sciolti.","in":["kurz","normal","lang"],"pause_s":{"kurz":6,"normal":10,"lang":16}}]},{"id":"atem","pegel_db":-1,"segmente":[{"id":"s014","art":"sprache","datei":"es/14.58f7fb14.mp3","ms":3009,"text":"Senti il respiro. Va da solo.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13},"pegel_db":-1},{"id":"s015","art":"sprache","datei":"es/15.fc4553a9.mp3","ms":6613,"text":"Lascia che l'espirazione diventi un po' più lunga dell'inspirazione. Senza alcuno sforzo.","in":["kurz","normal","lang"],"pause_s":{"kurz":6,"normal":10,"lang":16},"pegel_db":-1},{"id":"s016","art":"sprache","datei":"es/16.f380573b.mp3","ms":3653,"text":"A ogni espirazione sprofondi un po' di più nel materasso.","in":["kurz","normal","lang"],"pause_s":{"kurz":7,"normal":12,"lang":19},"pegel_db":-1},{"id":"st01","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":60.6,"normal":63,"lang":101}},{"id":"s017","art":"sprache","datei":"es/17.0f2cf9a9.mp3","ms":6338,"text":"Non c'è bisogno di contare. Lascia semplicemente che il respiro sia lento e morbido.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19},"pegel_db":-1},{"id":"st02","art":"stille","in":["normal","lang"],"dauer_s":{"normal":63,"lang":101}}]},{"id":"schwere","pegel_db":-3,"segmente":[{"id":"s018","art":"sprache","datei":"es/18.188c5c8e.mp3","ms":2295,"text":"I tuoi piedi sono pesanti e caldi.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19},"pegel_db":-3},{"id":"s019","art":"sprache","datei":"es/19.1dbce5da.mp3","ms":1863,"text":"Le tue gambe sono pesanti.","in":["kurz","normal","lang"],"pause_s":{"kurz":7,"normal":12,"lang":19},"pegel_db":-3},{"id":"s020","art":"sprache","datei":"es/20.f508c4f8.mp3","ms":2316,"text":"Le tue mani sono pesanti e calde.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19},"pegel_db":-3},{"id":"s021","art":"sprache","datei":"es/21.2105b67c.mp3","ms":1872,"text":"Le tue braccia sono pesanti.","in":["kurz","normal","lang"],"pause_s":{"kurz":7,"normal":12,"lang":19},"pegel_db":-3},{"id":"s022","art":"sprache","datei":"es/22.1a952343.mp3","ms":2394,"text":"La tua schiena affonda nel materasso.","in":["lang"],"pause_s":{"lang":19},"pegel_db":-3},{"id":"s023","art":"sprache","datei":"es/23.dbc8aa3a.mp3","ms":2564,"text":"Le tue spalle sono morbide e pesanti.","in":["lang"],"pause_s":{"lang":19},"pegel_db":-3},{"id":"s024","art":"sprache","datei":"es/24.60fdb190.mp3","ms":2629,"text":"La tua testa poggia pesante sul cuscino.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19},"pegel_db":-3},{"id":"s025","art":"sprache","datei":"es/25.c5a7f953.mp3","ms":1573,"text":"Il tuo viso è morbido.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19},"pegel_db":-3},{"id":"s026","art":"sprache","datei":"es/26.614bbc1b.mp3","ms":2408,"text":"Tutto il tuo corpo è pesante e caldo.","in":["kurz","normal","lang"],"pause_s":{"kurz":8.5,"normal":14,"lang":22.5},"pegel_db":-3},{"id":"st03","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":60.6,"normal":61,"lang":97.5}}]},{"id":"gedanken","pegel_db":-5,"segmente":[{"id":"s027","art":"sprache","datei":"es/27.dd0b6c2f.mp3","ms":6630,"text":"Se arrivano pensieri, va bene. Lasciali passare, come nuvole nella notte.","in":["kurz","normal","lang"],"pause_s":{"kurz":7,"normal":12,"lang":19},"pegel_db":-5},{"id":"s028","art":"sprache","datei":"es/28.68d2413e.mp3","ms":3912,"text":"E torna al respiro. All'espirazione lenta.","in":["kurz","normal","lang"],"pause_s":{"kurz":7,"normal":12,"lang":19},"pegel_db":-5},{"id":"st04","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":60.6,"normal":63,"lang":101}},{"id":"s029","art":"sprache","datei":"es/29.32d1f7db.mp3","ms":2628,"text":"Sei al caldo e al sicuro nel tuo letto.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19},"pegel_db":-5},{"id":"s030","art":"sprache","datei":"es/30.79159903.mp3","ms":4172,"text":"Ora puoi lasciar andare. La giornata è finita.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19},"pegel_db":-5},{"id":"st05","art":"stille","in":["normal","lang"],"dauer_s":{"normal":63,"lang":101}},{"id":"s031","art":"sprache","datei":"es/31.e635756a.mp3","ms":2145,"text":"Ora non deve succedere niente.","in":["lang"],"pause_s":{"lang":19},"pegel_db":-5},{"id":"st06","art":"stille","in":["lang"],"dauer_s":{"lang":101}}]},{"id":"ende","pegel_db":-7,"segmente":[{"id":"s032","art":"sprache","datei":"es/32.d3f8d333.mp3","ms":5421,"text":"Ora farò silenzio. Resta semplicemente lì, a riposare.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5},"pegel_db":-7},{"id":"s033","art":"sprache","datei":"es/33.5a0cbec0.mp3","ms":1056,"text":"Buonanotte.","in":["kurz","normal","lang"],"pause_s":{"kurz":1,"normal":2,"lang":3},"pegel_db":-7},{"id":"st07","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":121.2,"normal":215.7,"lang":314.1},"ende_stille":true}]}]}