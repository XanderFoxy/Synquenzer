{"format":1,"id":"ruheort","kurz":"ro","sprache":"de","richtung":"ltr","titel":"Ruheort – eine Wiese","untertitel":"Eine Fantasiereise auf eine grüne Wiese, mit allen Sinnen.","haltung":["liegen","sitzen_angelehnt"],"augen":"zu_oder_offen","ende":"glocke","schlaf_modus":false,"laengen":{"kurz":{"ziel_s":300},"normal":{"ziel_s":720},"lang":{"ziel_s":1200}},"kb":1101,"abschnitte":[{"id":"ankommen","segmente":[{"id":"s001","art":"sprache","datei":"ro/1.5b148cf8.mp3","ms":3793,"text":"Leg dich hin, oder setz dich bequem angelehnt hin.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s002","art":"sprache","datei":"ro/2.4a61a41d.mp3","ms":5736,"text":"Schließ die Augen, wenn du magst. Du kannst sie jederzeit öffnen.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s003","art":"sprache","datei":"ro/3.8eceabd2.mp3","ms":4716,"text":"Du gehst gleich in Gedanken an einen ruhigen Ort, auf eine Wiese.","in":["kurz","normal","lang"],"pause_s":{"kurz":1,"normal":2,"lang":3}},{"id":"s004","art":"sprache","datei":"ro/4.2a8dd435.mp3","ms":8030,"text":"Wenn dir ein anderer Ort lieber ist, ein Waldrand oder ein Strand, dann geh dorthin. Du bestimmst.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s005","art":"sprache","datei":"ro/5.7deb5db4.mp3","ms":7855,"text":"Lass den Atem ein paarmal ruhig und lang ausströmen. Er darf langsamer werden, ohne Druck.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"s006","art":"sprache","datei":"ro/6.22056710.mp3","ms":3678,"text":"Mit jedem Ausatmen wird dein Körper etwas schwerer.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}}]},{"id":"weg","segmente":[{"id":"s007","art":"sprache","datei":"ro/7.505144e8.mp3","ms":4077,"text":"Stell dir vor, du gehst einen schmalen Weg entlang.","in":["kurz","normal","lang"],"pause_s":{"kurz":3,"normal":5,"lang":8}},{"id":"s008","art":"sprache","datei":"ro/8.fbf6e861.mp3","ms":2907,"text":"Der Boden unter deinen Füßen ist weich.","in":["normal","lang"],"pause_s":{"normal":5,"lang":8}},{"id":"s009","art":"sprache","datei":"ro/9.3a0b3855.mp3","ms":3533,"text":"Vor dir öffnet sich eine weite, grüne Wiese.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"st01","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":41.2,"normal":61.9,"lang":65.5}},{"id":"s010","art":"sprache","datei":"ro/10.b8272a5a.mp3","ms":5508,"text":"Es ist ein angenehmer Tag. Nicht zu warm, nicht zu kühl.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}}]},{"id":"sinne","segmente":[{"id":"s011","art":"sprache","datei":"ro/11.d412d463.mp3","ms":4583,"text":"Schau dich um. Das Gras ist grün und frisch.","in":["kurz","normal","lang"],"pause_s":{"kurz":5.5,"normal":9,"lang":14.5}},{"id":"s012","art":"sprache","datei":"ro/12.28716b14.mp3","ms":5410,"text":"Vielleicht siehst du Blumen. Weiß, gelb, violett.","in":["normal","lang"],"pause_s":{"normal":9,"lang":14.5}},{"id":"s013","art":"sprache","datei":"ro/13.707d9fb3.mp3","ms":2090,"text":"Über dir ist der Himmel weit.","in":["kurz","normal","lang"],"pause_s":{"kurz":5.5,"normal":9,"lang":14.5}},{"id":"s014","art":"sprache","datei":"ro/14.05c85872.mp3","ms":2820,"text":"Ein paar Wolken ziehen langsam vorbei.","in":["normal","lang"],"pause_s":{"normal":9,"lang":14.5}},{"id":"s015","art":"sprache","datei":"ro/15.e1903a67.mp3","ms":2627,"text":"In der Ferne steht eine Reihe Bäume.","in":["lang"],"pause_s":{"lang":11}},{"id":"st02","art":"stille","in":["normal","lang"],"dauer_s":{"normal":61.9,"lang":65.5}},{"id":"s016","art":"sprache","datei":"ro/16.498ed122.mp3","ms":3587,"text":"Hör hin. Vielleicht hörst du Vögel.","in":["kurz","normal","lang"],"pause_s":{"kurz":5.5,"normal":9,"lang":14.5}},{"id":"s017","art":"sprache","datei":"ro/17.23e547c5.mp3","ms":3077,"text":"Das leise Rascheln des Grases im Wind.","in":["normal","lang"],"pause_s":{"normal":9,"lang":14.5}},{"id":"s018","art":"sprache","datei":"ro/18.416ff6f1.mp3","ms":4230,"text":"Vielleicht summt irgendwo eine Biene, oder ein Bach plätschert.","in":["lang"],"pause_s":{"lang":11}},{"id":"s019","art":"sprache","datei":"ro/19.4b3afe68.mp3","ms":5545,"text":"Atme die frische Luft ein. Sie riecht nach Gras und Erde.","in":["normal","lang"],"pause_s":{"normal":9,"lang":14.5}},{"id":"s020","art":"sprache","datei":"ro/20.ef394d13.mp3","ms":3303,"text":"Vielleicht auch nach Blüten, oder nach Regen.","in":["lang"],"pause_s":{"lang":11}},{"id":"s021","art":"sprache","datei":"ro/21.ae744ba8.mp3","ms":2883,"text":"Spür den sanften Wind auf deiner Haut.","in":["kurz","normal","lang"],"pause_s":{"kurz":5.5,"normal":9,"lang":14.5}},{"id":"s022","art":"sprache","datei":"ro/22.a7121c80.mp3","ms":2524,"text":"Und die Wärme der Sonne im Gesicht.","in":["kurz","normal","lang"],"pause_s":{"kurz":5.5,"normal":9,"lang":14.5}},{"id":"st03","art":"stille","in":["kurz"],"dauer_s":{"kurz":39.5}}]},{"id":"ruhen","segmente":[{"id":"s023","art":"sprache","datei":"ro/23.eba90eeb.mp3","ms":5065,"text":"Such dir einen schönen Platz auf der Wiese, und setz oder leg dich hin.","in":["kurz","normal","lang"],"pause_s":{"kurz":3,"normal":5,"lang":8}},{"id":"s024","art":"sprache","datei":"ro/24.2d2b96bb.mp3","ms":2775,"text":"Spür, wie das Gras dich trägt.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s025","art":"sprache","datei":"ro/25.f687baeb.mp3","ms":4718,"text":"Hier musst du nichts tun. Du darfst einfach ausruhen.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"st04","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":41.2,"normal":61.9,"lang":65.5}},{"id":"s026","art":"sprache","datei":"ro/26.124fcae1.mp3","ms":4828,"text":"Die Sonne wärmt dich angenehm. Der Wind ist sanft.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s027","art":"sprache","datei":"ro/27.b9a4dfb2.mp3","ms":3029,"text":"Spür, wie ruhig dein Körper werden kann.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"st05","art":"stille","in":["normal","lang"],"dauer_s":{"normal":61.9,"lang":65.5}},{"id":"s028","art":"sprache","datei":"ro/28.bc2cc507.mp3","ms":4143,"text":"Wenn Gedanken kommen, lass sie weiterziehen wie die Wolken.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"st06","art":"stille","in":["normal","lang"],"dauer_s":{"normal":61.9,"lang":65.5}},{"id":"s029","art":"sprache","datei":"ro/29.68f5a07e.mp3","ms":3215,"text":"Lausch noch einmal den Vögeln und dem Wind.","in":["lang"],"pause_s":{"lang":9.5}},{"id":"st07","art":"stille","in":["lang"],"dauer_s":{"lang":65.5}},{"id":"s030","art":"sprache","datei":"ro/30.f97862a3.mp3","ms":7770,"text":"Vielleicht magst du barfuß ein paar Schritte durch das Gras gehen. Kühl und weich unter den Füßen.","in":["lang"],"pause_s":{"lang":13}},{"id":"s031","art":"sprache","datei":"ro/31.93c9d0bb.mp3","ms":5611,"text":"Am Rand der Wiese fließt ein kleiner Bach. Du hörst das Wasser.","in":["lang"],"pause_s":{"lang":13}},{"id":"s032","art":"sprache","datei":"ro/32.9cc156e4.mp3","ms":5142,"text":"Setz dich ans Ufer und schau zu, wie das Wasser ruhig vorbeifließt.","in":["lang"],"pause_s":{"lang":13}},{"id":"st08","art":"stille","in":["lang"],"dauer_s":{"lang":65.5}},{"id":"s033","art":"sprache","datei":"ro/33.652cc036.mp3","ms":3116,"text":"Dann geh zurück zu deinem Platz in der Sonne.","in":["lang"],"pause_s":{"lang":9.5}},{"id":"s034","art":"sprache","datei":"ro/34.09fd26a6.mp3","ms":3892,"text":"Alles hier ist ruhig. Du hast Zeit.","in":["lang"],"pause_s":{"lang":9.5}},{"id":"st09","art":"stille","in":["lang"],"dauer_s":{"lang":65.5}}]},{"id":"merken","segmente":[{"id":"s035","art":"sprache","datei":"ro/35.fc8998dd.mp3","ms":5994,"text":"Präg dir diesen Ort ein. Die Farben, die Geräusche, die Luft.","in":["kurz","normal","lang"],"pause_s":{"kurz":3,"normal":5,"lang":8}},{"id":"s036","art":"sprache","datei":"ro/36.46d93bac.mp3","ms":3814,"text":"Du kannst jederzeit in Gedanken hierher zurückkommen.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s037","art":"sprache","datei":"ro/37.ec4a2b65.mp3","ms":3617,"text":"Nimm noch ein paar ruhige Atemzüge an diesem Ort.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"st10","art":"stille","in":["normal","lang"],"dauer_s":{"normal":61.9,"lang":65.5}}]},{"id":"rueckweg","segmente":[{"id":"s038","art":"sprache","datei":"ro/38.9b85b8bb.mp3","ms":3784,"text":"Steh jetzt langsam auf und geh zurück zum Weg.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s039","art":"sprache","datei":"ro/39.78a5a6d0.mp3","ms":5145,"text":"Mit jedem Schritt kommst du mehr hierher zurück, in den Raum, in dem du bist.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s040","art":"sprache","datei":"ro/40.1d18138a.mp3","ms":3370,"text":"Spür deinen Körper, wie er liegt oder sitzt.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s041","art":"sprache","datei":"ro/41.d1db9f55.mp3","ms":2681,"text":"Atme etwas tiefer ein und aus.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s042","art":"sprache","datei":"ro/42.3a082a6d.mp3","ms":4470,"text":"Beweg die Finger und die Zehen. Streck dich.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s043","art":"sprache","datei":"ro/43.98d7f9bb.mp3","ms":2968,"text":"Öffne die Augen, wenn du so weit bist.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s044","art":"sprache","datei":"ro/44.844b3c25.mp3","ms":3483,"text":"Wenn du gelegen hast, steh langsam auf.","in":["kurz","normal","lang"],"pause_s":{"kurz":1,"normal":2,"lang":3}},{"id":"glocke","art":"glocke","ton":"ende"}]}]}