{"format":1,"id":"einschlafen","kurz":"es","sprache":"de","richtung":"ltr","titel":"Zur Ruhe kommen im Bett","untertitel":"Den Tag ablegen, Muskeln lösen, langsam ausatmen. Die Stimme wird leiser und hört ohne Ton auf.","haltung":["im_bett"],"augen":"zu_oder_offen","ende":"still","schlaf_modus":false,"laengen":{"kurz":{"ziel_s":480},"normal":{"ziel_s":900},"lang":{"ziel_s":1500}},"kb":790,"abschnitte":[{"id":"ankommen","segmente":[{"id":"s001","art":"sprache","datei":"es/1.ee6cc6dd.mp3","ms":6049,"text":"Leg dich so hin, wie du sonst einschläfst. Mach das Licht aus.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s002","art":"sprache","datei":"es/2.cbbde6c5.mp3","ms":4770,"text":"Leg das Handy so hin, dass du nicht mehr auf den Bildschirm schaust.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s003","art":"sprache","datei":"es/3.b9267edf.mp3","ms":11867,"text":"Du musst jetzt nichts mehr schaffen. Auch nicht einschlafen. Du darfst einfach ausruhen. Und du kannst jederzeit aufhören.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}}]},{"id":"ablegen","segmente":[{"id":"s004","art":"sprache","datei":"es/4.07420b88.mp3","ms":8593,"text":"Gehen dir noch Dinge für morgen durch den Kopf? Stell dir vor, du legst sie in eine Kiste neben dem Bett.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"s005","art":"sprache","datei":"es/5.b125a46b.mp3","ms":2798,"text":"Morgen kannst du sie wieder herausholen.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"s006","art":"sprache","datei":"es/6.49d6d2fc.mp3","ms":4987,"text":"Wenn dich etwas nicht loslässt, kannst du es auch kurz aufschreiben.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}}]},{"id":"muskeln","segmente":[{"id":"s007","art":"sprache","datei":"es/7.23927506.mp3","ms":5463,"text":"Mach die Hände für einen Moment zu Fäusten. Ganz leicht.","in":["kurz","normal","lang"],"pause_s":{"kurz":4,"normal":4,"lang":4},"pause_fest":true},{"id":"s008","art":"sprache","datei":"es/8.ddc1c6ce.mp3","ms":1425,"text":"Und lass los.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s009","art":"sprache","datei":"es/9.c5c1daac.mp3","ms":3271,"text":"Zieh die Schultern ein wenig zu den Ohren hoch.","in":["kurz","normal","lang"],"pause_s":{"kurz":4,"normal":4,"lang":4},"pause_fest":true},{"id":"s010","art":"sprache","datei":"es/10.bd092ea8.mp3","ms":1550,"text":"Und lass sie sinken.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s011","art":"sprache","datei":"es/11.446a72dc.mp3","ms":2900,"text":"Kneif das Gesicht ein wenig zusammen.","in":["normal","lang"],"pause_s":{"normal":4,"lang":4},"pause_fest":true},{"id":"s012","art":"sprache","datei":"es/12.8428b1a7.mp3","ms":1965,"text":"Und lass es weich werden.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"s013","art":"sprache","datei":"es/13.752f84b1.mp3","ms":3381,"text":"Spür, wie die Muskeln jetzt lockerer sind.","in":["kurz","normal","lang"],"pause_s":{"kurz":6,"normal":10,"lang":16}}]},{"id":"atem","pegel_db":-1,"segmente":[{"id":"s014","art":"sprache","datei":"es/14.e959193a.mp3","ms":4316,"text":"Spür deinen Atem. Er geht von allein.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13},"pegel_db":-1},{"id":"s015","art":"sprache","datei":"es/15.f5938515.mp3","ms":7005,"text":"Lass das Ausatmen etwas länger werden als das Einatmen. Ganz ohne Mühe.","in":["kurz","normal","lang"],"pause_s":{"kurz":6,"normal":10,"lang":16},"pegel_db":-1},{"id":"s016","art":"sprache","datei":"es/16.1dd1b174.mp3","ms":4648,"text":"Mit jedem Ausatmen sinkst du ein wenig tiefer in die Matratze.","in":["kurz","normal","lang"],"pause_s":{"kurz":7,"normal":12,"lang":19},"pegel_db":-1},{"id":"st01","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":57.8,"normal":63,"lang":101}},{"id":"s017","art":"sprache","datei":"es/17.7ad36e66.mp3","ms":6130,"text":"Du musst nicht zählen. Lass den Atem einfach langsam und weich sein.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19},"pegel_db":-1},{"id":"st02","art":"stille","in":["normal","lang"],"dauer_s":{"normal":63,"lang":101}}]},{"id":"schwere","pegel_db":-3,"segmente":[{"id":"s018","art":"sprache","datei":"es/18.093315f4.mp3","ms":2672,"text":"Deine Füße sind schwer und warm.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19},"pegel_db":-3},{"id":"s019","art":"sprache","datei":"es/19.aa32ba46.mp3","ms":1944,"text":"Deine Beine sind schwer.","in":["kurz","normal","lang"],"pause_s":{"kurz":7,"normal":12,"lang":19},"pegel_db":-3},{"id":"s020","art":"sprache","datei":"es/20.cb982e9f.mp3","ms":2632,"text":"Deine Hände sind schwer und warm.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19},"pegel_db":-3},{"id":"s021","art":"sprache","datei":"es/21.8d632ffb.mp3","ms":1955,"text":"Deine Arme sind schwer.","in":["kurz","normal","lang"],"pause_s":{"kurz":7,"normal":12,"lang":19},"pegel_db":-3},{"id":"s022","art":"sprache","datei":"es/22.44780b4a.mp3","ms":2503,"text":"Dein Rücken sinkt in die Matratze.","in":["lang"],"pause_s":{"lang":19},"pegel_db":-3},{"id":"s023","art":"sprache","datei":"es/23.46f4b380.mp3","ms":2792,"text":"Deine Schultern sind weich und schwer.","in":["lang"],"pause_s":{"lang":19},"pegel_db":-3},{"id":"s024","art":"sprache","datei":"es/24.92dc5870.mp3","ms":2460,"text":"Dein Kopf liegt schwer im Kissen.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19},"pegel_db":-3},{"id":"s025","art":"sprache","datei":"es/25.6a3a1920.mp3","ms":1946,"text":"Dein Gesicht ist weich.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19},"pegel_db":-3},{"id":"s026","art":"sprache","datei":"es/26.d73c097d.mp3","ms":3061,"text":"Dein ganzer Körper ist schwer und warm.","in":["kurz","normal","lang"],"pause_s":{"kurz":8.5,"normal":14,"lang":22.5},"pegel_db":-3},{"id":"st03","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":57.8,"normal":61,"lang":97.5}}]},{"id":"gedanken","pegel_db":-5,"segmente":[{"id":"s027","art":"sprache","datei":"es/27.505e297d.mp3","ms":7778,"text":"Wenn Gedanken kommen, ist das in Ordnung. Lass sie vorbeiziehen, wie Wolken in der Nacht.","in":["kurz","normal","lang"],"pause_s":{"kurz":7,"normal":12,"lang":19},"pegel_db":-5},{"id":"s028","art":"sprache","datei":"es/28.40ad848b.mp3","ms":5399,"text":"Und kehr zum Atem zurück. Zum langsamen Ausatmen.","in":["kurz","normal","lang"],"pause_s":{"kurz":7,"normal":12,"lang":19},"pegel_db":-5},{"id":"st04","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":57.8,"normal":63,"lang":101}},{"id":"s029","art":"sprache","datei":"es/29.cb3b6e24.mp3","ms":2947,"text":"Du bist warm und geborgen in deinem Bett.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19},"pegel_db":-5},{"id":"s030","art":"sprache","datei":"es/30.2c87133f.mp3","ms":4868,"text":"Du darfst jetzt loslassen. Der Tag ist vorbei.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19},"pegel_db":-5},{"id":"st05","art":"stille","in":["normal","lang"],"dauer_s":{"normal":63,"lang":101}},{"id":"s031","art":"sprache","datei":"es/31.4b9f7f69.mp3","ms":2053,"text":"Nichts muss jetzt passieren.","in":["lang"],"pause_s":{"lang":19},"pegel_db":-5},{"id":"st06","art":"stille","in":["lang"],"dauer_s":{"lang":101}}]},{"id":"ende","pegel_db":-7,"segmente":[{"id":"s032","art":"sprache","datei":"es/32.e9d45bde.mp3","ms":5711,"text":"Ich werde jetzt still. Bleib einfach liegen und ruh dich aus.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5},"pegel_db":-7},{"id":"s033","art":"sprache","datei":"es/33.489e7ee6.mp3","ms":1139,"text":"Gute Nacht.","in":["kurz","normal","lang"],"pause_s":{"kurz":1,"normal":2,"lang":3},"pegel_db":-7},{"id":"st07","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":115.7,"normal":199.3,"lang":297.5},"ende_stille":true}]}]}