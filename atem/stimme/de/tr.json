"s026","art":"sprache","datei":"tr/17.a2d23cdd.mp3","ms":7775,"text":"Linke Hand. Daumen, Zeigefinger, Mittelfinger, Ringfinger, kleiner Finger.","in":["lang"],"pause_s":{"lang":2},"pause_fest":true},{"id":"s027","art":"sprache","datei":"tr/15.df57168d.mp3","ms":7636,"text":"Handfläche, Handrücken, Handgelenk, Unterarm, Ellenbogen, Oberarm, Schulter.","in":["lang"],"pause_s":{"lang":2},"pause_fest":true},{"id":"s028","art":"sprache","datei":"tr/19.35813e82.mp3","ms":9146,"text":"Linke Seite des Körpers. Hüfte, Oberschenkel, Knie, Unterschenkel, Fuß, Zehen.","in":["lang"],"pause_s":{"lang":3},"pause_fest":true},{"id":"s029","art":"sprache","datei":"tr/20.96e40361.mp3","ms":6465,"text":"Rücken. Schulterblätter, Wirbelsäule, unterer Rücken, Gesäß.","in":["lang"],"pause_s":{"lang":2},"pause_fest":true},{"id":"s030","art":"sprache","datei":"tr/21.19acd99b.mp3","ms":8951,"text":"Bauch, Brust, Hals, Kinn, Lippen, Nase, Wangen, Augen, Stirn, Scheitel.","in":["lang"],"pause_s":{"lang":3},"pause_fest":true},{"id":"s031","art":"sprache","datei":"tr/31.51fc744b.mp3","ms":5032,"text":"Der ganze Körper. Der ganze Körper liegt ruhig da.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"st02","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":65.5,"normal":72.6,"lang":78.3}}]},{"id":"atem","segmente":[{"id":"s032","art":"sprache","datei":"tr/32.8b7ef65c.mp3","ms":7815,"text":"Spür jetzt den Atem an der Nase. Kühl beim Einatmen, etwas wärmer beim Ausatmen.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"s033","art":"sprache","datei":"tr/33.4633ccbd.mp3","ms":1740,"text":"Spür ihn im Hals.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s034","art":"sprache","datei":"tr/34.32af30e5.mp3","ms":1178,"text":"In der Brust.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s035","art":"sprache","datei":"tr/35.783596f2.mp3","ms":840,"text":"Im Bauch.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s036","art":"sprache","datei":"tr/36.d610b269.mp3","ms":2713,"text":"Der Atem kommt und geht von allein.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"st03","art":"stille","in":["normal","lang"],"dauer_s":{"normal":72.6,"lang":78.3}}]},{"id":"atem_zaehlen","segmente":[{"id":"s037","art":"sprache","datei":"tr/37.6b8c6f2f.mp3","ms":8011,"text":"Zähl jetzt innerlich rückwärts, bei jedem Ausatmen eine Zahl. Von zehn bis eins.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s038","art":"sprache","datei":"tr/38.f25d0bb7.mp3","ms":7559,"text":"Wenn du dich verzählst, fang einfach wieder bei zehn an. Es geht nicht ums Ankommen.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"st04","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":65.5,"normal":72.6,"lang":78.3}},{"id":"s039","art":"sprache","datei":"tr/39.4c9a8184.mp3","ms":2542,"text":"Zähl weiter, ganz in Ruhe.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"st05","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":65.5,"normal":72.6,"lang":78.3}},{"id":"s040","art":"sprache","datei":"tr/40.d0fb80d2.mp3","ms":4598,"text":"Wenn du bei eins angekommen bist, fang wieder bei zehn an.","in":["normal","lang"],"pause_s":{"normal":3,"lang":5}},{"id":"st06","art":"stille","in":["normal","lang"],"dauer_s":{"normal":72.6,"lang":78.3}},{"id":"s041","art":"sprache","datei":"tr/41.fb0290d0.mp3","ms":5074,"text":"Lass das Zählen jetzt los. Spür nur noch den Atem.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"st07","art":"stille","in":["lang"],"dauer_s":{"lang":78.3}}]},{"id":"gegensaetze","segmente":[{"id":"s042","art":"sprache","datei":"tr/42.4a47b169.mp3","ms":8123,"text":"Erinnere dich an ein Gefühl von Schwere. Als ob dein Körper ganz schwer in die Unterlage sinkt.","in":["kurz","normal","lang"],"pause_s":{"kurz":7,"normal":12,"lang":19}},{"id":"s043","art":"sprache","datei":"tr/43.d31a83af.mp3","ms":8090,"text":"Und jetzt an ein Gefühl von Leichtigkeit. Als ob dein Körper ganz leicht wird, wie eine Feder.","in":["kurz","normal","lang"],"pause_s":{"kurz":7,"normal":12,"lang":19}},{"id":"s044","art":"sprache","datei":"tr/44.07c83d6f.mp3","ms":2689,"text":"Schwer. Und leicht.","in":["normal","lang"],"pause_s":{"normal":10,"lang":16}},{"id":"st08","art":"stille","in":["kurz"],"dauer_s":{"kurz":65.5}},{"id":"s045","art":"sprache","datei":"tr/45.bceb7b49.mp3","ms":4868,"text":"Erinnere dich an Wärme. Wie Sonne auf der Haut.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19}},{"id":"s046","art":"sprache","datei":"tr/46.b21b0a57.mp3","ms":5117,"text":"Und an Kühle. Wie frische Luft an einem Sommermorgen.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19}},{"id":"s047","art":"sprache","datei":"tr/47.b6dd0dee.mp3","ms":2499,"text":"Warm. Und kühl.","in":["lang"],"pause_s":{"lang":16}},{"id":"st09","art":"stille","in":["normal","lang"],"dauer_s":{"normal":72.6,"lang":78.3}}]},{"id":"bilder","segmente":[{"id":"s048","art":"sprache","datei":"tr/48.e9df5a40.mp3","ms":6590,"text":"Ich nenne jetzt ein paar ruhige Bilder. Lass sie kurz auftauchen und wieder gehen.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s049","art":"sprache","datei":"tr/49.6d45ffb1.mp3","ms":2047,"text":"Ein stiller See am Morgen.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s050","art":"sprache","datei":"tr/50.6a887e19.mp3","ms":3562,"text":"Eine Wolke, die langsam über den Himmel zieht.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s051","art":"sprache","datei":"tr/51.03c339b6.mp3","ms":2662,"text":"Eine Kerze in einem ruhigen Raum.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"s052","art":"sprache","datei":"tr/52.5f1bff0b.mp3","ms":2049,"text":"Ein Weg durch einen Wald.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"s053","art":"sprache","datei":"tr/53.9ccb14cd.mp3","ms":2733,"text":"Wellen, die an einen Strand rollen.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"s054","art":"sprache","datei":"tr/54.ef3ce124.mp3","ms":1522,"text":"Ein Sternenhimmel.","in":["lang"],"pause_s":{"lang":13}},{"id":"s055","art":"sprache","datei":"tr/55.2e5af248.mp3","ms":2596,"text":"Ein warmes Licht in einem Fenster.","in":["lang"],"pause_s":{"lang":13}},{"id":"s056","art":"sprache","datei":"tr/56.c4cd3b1c.mp3","ms":2959,"text":"Ein Vogel, der hoch oben kreist.","in":["lang"],"pause_s":{"lang":13}},{"id":"st10","art":"stille","in":["lang"],"dauer_s":{"lang":78.3}}]},{"id":"stille","segmente":[{"id":"s057","art":"sprache","datei":"tr/57.c28d7b61.mp3","ms":4758,"text":"Und jetzt nur Stille. Du bleibst wach und ruhst.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"st11","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":65.5,"normal":72.6,"lang":78.3}},{"id":"s058","art":"sprache","datei":"tr/58.6d21a879.mp3","ms":6252,"text":"Du ruhst. Der Körper ruht. Der Atem geht von allein.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s059","art":"sprache","datei":"tr/59.2061819e.mp3","ms":6049,"text":"Wenn du merkst, dass du wegdämmerst, hör wieder auf die Stimme und die Geräusche.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"st12","art":"stille","in":["normal","lang"],"dauer_s":{"normal":72.6,"lang":78.3}},{"id":"s060","art":"sprache","datei":"tr/60.4b895631.mp3","ms":2953,"text":"Spür, wie still es in dir sein kann.","in":["lang"],"pause_s":{"lang":9.5}},{"id":"st13","art":"stille","in":["lang"],"dauer_s":{"lang":78.3}}]},{"id":"vorsatz_ende","segmente":[{"id":"s061","art":"sprache","datei":"tr/61.168a595e.mp3","ms":6633,"text":"Erinnere dich an deinen Satz vom Anfang. Sag ihn innerlich noch dreimal.","in":["kurz","normal","lang"],"pause_s":{"kurz":10,"normal":10,"lang":10},"pause_fest":true}]},{"id":"rueckkehr","segmente":[{"id":"s062","art":"sprache","datei":"tr/62.8bcf032b.mp3","ms":2019,"text":"Langsam kommst du zurück.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s063","art":"sprache","datei":"tr/63.37d50bce.mp3","ms":3611,"text":"Spür wieder deinen ganzen Körper, wie er liegt.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s064","art":"sprache","datei":"tr/64.80f11fe1.mp3","ms":2270,"text":"Hör die Geräusche um dich herum.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s065","art":"sprache","datei":"tr/65.a477d8aa.mp3","ms":3539,"text":"Beweg die Finger und die Zehen, ganz langsam.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s066","art":"sprache","datei":"tr/66.d9eb0a24.mp3","ms":2298,"text":"Streck dich, wenn du magst.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s067","art":"sprache","datei":"tr/67.44a7e28c.mp3","ms":4083,"text":"Roll dich auf die Seite und bleib dort noch einen Moment.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"s068","art":"sprache","datei":"tr/68.ccf3654c.mp3","ms":3526,"text":"Dann setz dich langsam auf und öffne die Augen.","in":["kurz","normal","lang"],"pause_s":{"kurz":1,"normal":2,"lang":3}},{"id":"glocke","art":"glocke","ton":"ende"}]}]}