{"format":1,"id":"klaenge_hoeren","kurz":"kh","sprache":"en","richtung":"ltr","titel":"Listening to sounds","untertitel":"Listen to the sounds around you as they come and go, without judging them.","haltung":["sitzen","liegen"],"augen":"zu_oder_offen","ende":"glocke","schlaf_modus":false,"laengen":{"kurz":{"ziel_s":180},"normal":{"ziel_s":480},"lang":{"ziel_s":900}},"kb":539,"abschnitte":[{"id":"ankommen","segmente":[{"id":"s001","art":"sprache","datei":"kh/1.5c829a23.mp3","ms":2398,"text":"Sit comfortably, or lie down.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5.7}},{"id":"s002","art":"sprache","datei":"kh/2.ec4b447d.mp3","ms":4494,"text":"Close your eyes if you like. You can stop at any time.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5.7}},{"id":"s003","art":"sprache","datei":"kh/3.71b98c82.mp3","ms":5840,"text":"In this practice, you simply listen. There's no right or wrong thing to hear.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5.7}},{"id":"s004","art":"sprache","datei":"kh/4.e00954f6.mp3","ms":1753,"text":"Take a few calm breaths.","in":["normal","lang"],"pause_s":{"normal":4,"lang":7.4}}]},{"id":"nah","segmente":[{"id":"s005","art":"sprache","datei":"kh/5.3842fe47.mp3","ms":6380,"text":"First, listen to sounds very close to you. In the room, and from your own body.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":10.8}},{"id":"s006","art":"sprache","datei":"kh/6.53418693.mp3","ms":5500,"text":"Perhaps your breathing. The rustle of your clothes. A ticking.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"st01","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":22.4,"normal":62.1,"lang":62}}]},{"id":"fern","segmente":[{"id":"s007","art":"sprache","datei":"kh/7.dda88d7e.mp3","ms":5487,"text":"Now let your listening widen. To sounds outside, farther away.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":10.8}},{"id":"s008","art":"sprache","datei":"kh/8.d6106691.mp3","ms":5974,"text":"Cars, wind, voices, birds. Whatever is there right now.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"st02","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":22.4,"normal":62.1,"lang":62}}]},{"id":"eigenschaften","segmente":[{"id":"s009","art":"sprache","datei":"kh/9.fb1b9757.mp3","ms":4462,"text":"You don't need to name the sounds. Just hear how they sound.","in":["normal","lang"],"pause_s":{"normal":6,"lang":10.8}},{"id":"s010","art":"sprache","datei":"kh/10.b0544433.mp3","ms":5140,"text":"Loud or soft. High or low. Short or long.","in":["normal","lang"],"pause_s":{"normal":8,"lang":14.8}},{"id":"s011","art":"sprache","datei":"kh/11.9e3455f1.mp3","ms":4396,"text":"How a sound begins, stays for a while, and fades away again.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"st03","art":"stille","in":["normal","lang"],"dauer_s":{"normal":62.1,"lang":62}}]},{"id":"stille_dazwischen","segmente":[{"id":"s012","art":"sprache","datei":"kh/12.f930466e.mp3","ms":3579,"text":"Now listen also to the silence between the sounds.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"st04","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":22.4,"normal":62.1,"lang":62}},{"id":"s013","art":"sprache","datei":"kh/13.fcc6094b.mp3","ms":3349,"text":"The silence is always there, even when it's loud.","in":["lang"],"pause_s":{"lang":9.5}},{"id":"st05","art":"stille","in":["lang"],"dauer_s":{"lang":65.5}}]},{"id":"gedanken","segmente":[{"id":"s014","art":"sprache","datei":"kh/14.6e30e63f.mp3","ms":2980,"text":"When a thought comes, treat it like a sound.","in":["lang"],"pause_s":{"lang":10.8}},{"id":"s015","art":"sprache","datei":"kh/15.c9174a99.mp3","ms":3686,"text":"It appears, stays for a while, and passes again.","in":["lang"],"pause_s":{"lang":14.8}},{"id":"s016","art":"sprache","datei":"kh/16.235b51be.mp3","ms":1662,"text":"You don't have to follow it.","in":["lang"],"pause_s":{"lang":13}},{"id":"st06","art":"stille","in":["lang"],"dauer_s":{"lang":62}}]},{"id":"offen","segmente":[{"id":"s017","art":"sprache","datei":"kh/17.a9034133.mp3","ms":5184,"text":"Now let in everything there is to hear. Without searching for anything.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"st07","art":"stille","in":["lang"],"dauer_s":{"lang":65.5}},{"id":"s018","art":"sprache","datei":"kh/18.dbcc5de0.mp3","ms":4167,"text":"When you notice you've drifted off, simply come back to the sounds.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"st08","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":22.4,"normal":62.1,"lang":65.5}},{"id":"s019","art":"sprache","datei":"kh/19.7122c9ad.mp3","ms":4918,"text":"Hear how the sounds arrive all by themselves, without you having to do anything.","in":["lang"],"pause_s":{"lang":9.5}},{"id":"st09","art":"stille","in":["lang"],"dauer_s":{"lang":65.5}}]},{"id":"rueckkehr","segmente":[{"id":"s020","art":"sprache","datei":"kh/20.b8a4051d.mp3","ms":2484,"text":"Slowly, you are coming to the end.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5.7}},{"id":"s021","art":"sprache","datei":"kh/21.e056ca89.mp3","ms":2697,"text":"Feel your body, sitting or lying.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":7.4}},{"id":"s022","art":"sprache","datei":"kh/22.f7d1c22c.mp3","ms":2184,"text":"Take one deep breath in and out.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5.7}},{"id":"s023","art":"sprache","datei":"kh/23.d8c2cd82.mp3","ms":1950,"text":"Open your eyes when you're ready.","in":["kurz","normal","lang"],"pause_s":{"kurz":1,"normal":2,"lang":3.4}},{"id":"glocke","art":"glocke","ton":"ende"}]}]}