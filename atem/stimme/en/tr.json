{"format":1,"id":"tiefe_ruhe","kurz":"tr","sprache":"en","richtung":"ltr","titel":"Deep rest, lying down","untertitel":"Guided rest between waking and sleep: body rotation, breath counting, opposites, calm images.","haltung":["liegen"],"augen":"zu_oder_offen","ende":"glocke","schlaf_modus":false,"laengen":{"kurz":{"ziel_s":600},"normal":{"ziel_s":1200},"lang":{"ziel_s":1800}},"kb":1474,"abschnitte":[{"id":"ankommen","segmente":[{"id":"s001","art":"sprache","datei":"tr/1.0f08623c.mp3","ms":6040,"text":"Lie on your back. A pillow under your head and another under your knees can help.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s002","art":"sprache","datei":"tr/2.ad0fb63a.mp3","ms":3374,"text":"Cover yourself with a blanket in case you get cold.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s003","art":"sprache","datei":"tr/3.54dfecd4.mp3","ms":6448,"text":"Your arms rest beside your body. Palms facing up, if that feels comfortable.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s004","art":"sprache","datei":"tr/4.b21fb63e.mp3","ms":4565,"text":"Close your eyes if you like. You can stop at any time.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s005","art":"sprache","datei":"tr/5.d800f973.mp3","ms":7605,"text":"In this practice, you stay awake and listen to the voice. If you do fall asleep, that's okay too.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s006","art":"sprache","datei":"tr/6.a481f808.mp3","ms":3253,"text":"Notice your body lying here and growing heavy.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"s007","art":"sprache","datei":"tr/7.5cd6db7f.mp3","ms":4129,"text":"Listen to the sounds around you. Near and far.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"st01","art":"stille","in":["normal","lang"],"dauer_s":{"normal":76.5,"lang":82.4}}]},{"id":"vorsatz","segmente":[{"id":"s008","art":"sprache","datei":"tr/8.6d719737.mp3","ms":7224,"text":"Now choose a short, kind phrase for yourself. For example: I allow myself to rest.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s009","art":"sprache","datei":"tr/9.9c8718d8.mp3","ms":2090,"text":"Or: I can let go now.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s010","art":"sprache","datei":"tr/10.3325e7fa.mp3","ms":3027,"text":"Silently repeat your phrase three times.","in":["kurz","normal","lang"],"pause_s":{"kurz":10,"normal":10,"lang":10},"pause_fest":true}]},{"id":"rundgang","segmente":[{"id":"s011","art":"sprache","datei":"tr/11.ba6495dd.mp3","ms":6691,"text":"Now your attention moves quickly through the body. Simply think of each place as I name it.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s012","art":"sprache","datei":"tr/12.dfa142cf.mp3","ms":6898,"text":"Right hand, right arm, right leg. Left hand, left arm, left leg.","in":["kurz"],"pause_s":{"kurz":3},"pause_fest":true},{"id":"s013","art":"sprache","datei":"tr/13.90ed4d95.mp3","ms":4238,"text":"Back, belly, chest, face, the whole head.","in":["kurz"],"pause_s":{"kurz":3},"pause_fest":true},{"id":"s014","art":"sprache","datei":"tr/14.93468da2.mp3","ms":7121,"text":"Right hand. Thumb, index finger, middle finger, ring finger, little finger.","in":["normal","lang"],"pause_s":{"normal":2,"lang":2},"pause_fest":true},{"id":"s015","art":"sprache","datei":"tr/15.3c7a36f2.mp3","ms":6284,"text":"Palm, back of the hand, wrist, forearm, elbow, upper arm, shoulder.","in":["normal","lang"],"pause_s":{"normal":2,"lang":2},"pause_fest":true},{"id":"s016","art":"sprache","datei":"tr/16.9622de3c.mp3","ms":6905,"text":"Right side of the body. Hip, thigh, knee, lower leg, foot, toes.","in":["normal","lang"],"pause_s":{"normal":3,"lang":3},"pause_fest":true},{"id":"s017","art":"sprache","datei":"tr/17.97f36c2e.mp3","ms":7164,"text":"Left hand. Thumb, index finger, middle finger, ring finger, little finger.","in":["normal","lang"],"pause_s":{"normal":2,"lang":2},"pause_fest":true},{"id":"s018","art":"sprache","datei":"tr/15.3c7a36f2.mp3","ms":6284,"text":"Palm, back of the hand, wrist, forearm, elbow, upper arm, shoulder.","in":["normal","lang"],"pause_s":{"normal":2,"lang":2},"pause_fest":true},{"id":"s019","art":"sprache","datei":"tr/19.ddb70fc2.mp3","ms":6874,"text":"Left side of the body. Hip, thigh, knee, lower leg, foot, toes.","in":["normal","lang"],"pause_s":{"normal":3,"lang":3},"pause_fest":true},{"id":"s020","art":"sprache","datei":"tr/20.7aafd502.mp3","ms":5391,"text":"Back. Shoulder blades, spine, lower back, buttocks.","in":["normal","lang"],"pause_s":{"normal":2,"lang":2},"pause_fest":true},{"id":"s021","art":"sprache","datei":"tr/21.70eab7ea.mp3","ms":8567,"text":"Belly, chest, throat, chin, lips, nose, cheeks, eyes, forehead, crown of the head.","in":["normal","lang"],"pause_s":{"normal":3,"lang":3},"pause_fest":true},{"id":"s022","art":"sprache","datei":"tr/22.0c692b07.mp3","ms":2087,"text":"Once more through the whole body.","in":["lang"],"pause_s":{"lang":2},"pause_fest":true},{"id":"s023","art":"sprache","datei":"tr/14.93468da2.mp3","ms":7121,"text":"Right hand. Thumb, index finger, middle finger, ring finger, little finger.","in":["lang"],"pause_s":{"lang":2},"pause_fest":true},{"id":"s024","art":"sprache","datei":"tr/15.3c7a36f2.mp3","ms":6284,"text":"Palm, back of the hand, wrist, forearm, elbow, upper arm, shoulder.","in":["lang"],"pause_s":{"lang":2},"pause_fest":true},{"id":"s025","art":"sprache","datei":"tr/16.9622de3c.mp3","ms":6905,"text":"Right side of the body. Hip, thigh, knee, lower leg, foot, toes.","in":["lang"],"pause_s":{"lang":3},"pause_fest":true},{"id":"s026","art":"sprache","datei":"tr/17.97f36c2e.mp3","ms":7164,"text":"Left hand. Thumb, index finger, middle finger, ring finger, little finger.","in":["lang"],"pause_s":{"lang":2},"pause_fest":true},{"id":"s027","art":"sprache","datei":"tr/15.3c7a36f2.mp3","ms":6284,"text":"Palm, back of the hand, wrist, forearm, elbow, upper arm, shoulder.","in":["lang"],"pause_s":{"lang":2},"pause_fest":true},{"id":"s028","art":"sprache","datei":"tr/19.ddb70fc2.mp3","ms":6874,"text":"Left side of the body. Hip, thigh, knee, lower leg, foot, toes.","in":["lang"],"pause_s":{"lang":3},"pause_fest":true},{"id":"s029","art":"sprache","datei":"tr/20.7aafd502.mp3","ms":5391,"text":"Back. Shoulder blades, spine, lower back, buttocks.","in":["lang"],"pause_s":{"lang":2},"pause_fest":true},{"id":"s030","art":"sprache","datei":"tr/21.70eab7ea.mp3","ms":8567,"text":"Belly, chest, throat, chin, lips, nose, cheeks, eyes, forehead, crown of the head.","in":["lang"],"pause_s":{"lang":3},"pause_fest":true},{"id":"s031","art":"sprache","datei":"tr/31.d1fd386a.mp3","ms":4312,"text":"The whole body. The whole body resting quietly.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"st02","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":69.9,"normal":76.5,"lang":82.4}}]},{"id":"atem","segmente":[{"id":"s032","art":"sprache","datei":"tr/32.df6d61be.mp3","ms":7084,"text":"Now feel the breath at your nostrils. Cool as you breathe in, a little warmer as you breathe out.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"s033","art":"sprache","datei":"tr/33.a1470196.mp3","ms":1584,"text":"Feel it in your throat.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s034","art":"sprache","datei":"tr/34.0191a9ac.mp3","ms":1144,"text":"In your chest.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s035","art":"sprache","datei":"tr/35.d45ed85a.mp3","ms":983,"text":"In your belly.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s036","art":"sprache","datei":"tr/36.d19c6760.mp3","ms":2446,"text":"The breath comes and goes on its own.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"st03","art":"stille","in":["normal","lang"],"dauer_s":{"normal":76.5,"lang":82.4}}]},{"id":"atem_zaehlen","segmente":[{"id":"s037","art":"sprache","datei":"tr/37.7bdb419a.mp3","ms":6957,"text":"Now count backwards silently, one number with each out-breath. From ten down to one.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s038","art":"sprache","datei":"tr/38.ea062ed2.mp3","ms":6370,"text":"If you lose count, simply start again at ten. It's not about getting to the end.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"st04","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":69.9,"normal":76.5,"lang":82.4}},{"id":"s039","art":"sprache","datei":"tr/39.8b54077d.mp3","ms":2852,"text":"Keep counting, calmly and gently.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"st05","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":69.9,"normal":76.5,"lang":82.4}},{"id":"s040","art":"sprache","datei":"tr/40.2a1d2140.mp3","ms":2976,"text":"When you reach one, start again at ten.","in":["normal","lang"],"pause_s":{"normal":3,"lang":5}},{"id":"st06","art":"stille","in":["normal","lang"],"dauer_s":{"normal":76.5,"lang":82.4}},{"id":"s041","art":"sprache","datei":"tr/41.54d8ff6c.mp3","ms":4210,"text":"Now let go of the counting. Just feel the breath.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"st07","art":"stille","in":["lang"],"dauer_s":{"lang":82.4}}]},{"id":"gegensaetze","segmente":[{"id":"s042","art":"sprache","datei":"tr/42.ad7dfc73.mp3","ms":7064,"text":"Recall a feeling of heaviness. As if your body were sinking heavily into the surface beneath you.","in":["kurz","normal","lang"],"pause_s":{"kurz":7,"normal":12,"lang":19}},{"id":"s043","art":"sprache","datei":"tr/43.62431c01.mp3","ms":6674,"text":"And now a feeling of lightness. As if your body were becoming very light, like a feather.","in":["kurz","normal","lang"],"pause_s":{"kurz":7,"normal":12,"lang":19}},{"id":"s044","art":"sprache","datei":"tr/44.98f41505.mp3","ms":2198,"text":"Heavy. And light.","in":["normal","lang"],"pause_s":{"normal":10,"lang":16}},{"id":"st08","art":"stille","in":["kurz"],"dauer_s":{"kurz":68}},{"id":"s045","art":"sprache","datei":"tr/45.dc890bd4.mp3","ms":3994,"text":"Recall warmth. Like sunshine on your skin.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19}},{"id":"s046","art":"sprache","datei":"tr/46.ac7a8c82.mp3","ms":4175,"text":"And coolness. Like fresh air on a summer morning.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19}},{"id":"s047","art":"sprache","datei":"tr/47.cd8d6ec4.mp3","ms":2184,"text":"Warm. And cool.","in":["lang"],"pause_s":{"lang":16}},{"id":"st09","art":"stille","in":["normal","lang"],"dauer_s":{"normal":76.5,"lang":82.4}}]},{"id":"bilder","segmente":[{"id":"s048","art":"sprache","datei":"tr/48.b083c18f.mp3","ms":6028,"text":"I'll now name a few calm images. Let each one appear briefly and then fade.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s049","art":"sprache","datei":"tr/49.350fe771.mp3","ms":1754,"text":"A still lake in the morning.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s050","art":"sprache","datei":"tr/50.8373339d.mp3","ms":3007,"text":"A cloud drifting slowly across the sky.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s051","art":"sprache","datei":"tr/51.c427ef3d.mp3","ms":2095,"text":"A candle in a quiet room.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"s052","art":"sprache","datei":"tr/52.0bfaf04c.mp3","ms":1815,"text":"A path through a forest.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"s053","art":"sprache","datei":"tr/53.13c6b2c4.mp3","ms":2182,"text":"Waves rolling onto a beach.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"s054","art":"sprache","datei":"tr/54.b93ec0e4.mp3","ms":1362,"text":"A starry sky.","in":["lang"],"pause_s":{"lang":13}},{"id":"s055","art":"sprache","datei":"tr/55.0d7fc13c.mp3","ms":1785,"text":"A warm light in a window.","in":["lang"],"pause_s":{"lang":13}},{"id":"s056","art":"sprache","datei":"tr/56.087f0e75.mp3","ms":2131,"text":"A bird circling high above.","in":["lang"],"pause_s":{"lang":13}},{"id":"st10","art":"stille","in":["lang"],"dauer_s":{"lang":82.4}}]},{"id":"stille","segmente":[{"id":"s057","art":"sprache","datei":"tr/57.7ee66309.mp3","ms":4908,"text":"And now, just silence. You stay awake, and rest.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"st11","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":69.9,"normal":76.5,"lang":82.4}},{"id":"s058","art":"sprache","datei":"tr/58.30dd4b82.mp3","ms":6064,"text":"You are resting. The body is resting. The breath moves on its own.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s059","art":"sprache","datei":"tr/59.dc40ef4e.mp3","ms":5567,"text":"If you notice yourself drifting off, listen again to the voice and the sounds around you.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"st12","art":"stille","in":["normal","lang"],"dauer_s":{"normal":76.5,"lang":82.4}},{"id":"s060","art":"sprache","datei":"tr/60.e2349b71.mp3","ms":2673,"text":"Notice how still it can be inside you.","in":["lang"],"pause_s":{"lang":9.5}},{"id":"st13","art":"stille","in":["lang"],"dauer_s":{"lang":82.4}}]},{"id":"vorsatz_ende","segmente":[{"id":"s061","art":"sprache","datei":"tr/61.a7dfe712.mp3","ms":5868,"text":"Remember your phrase from the beginning. Silently repeat it three more times.","in":["kurz","normal","lang"],"pause_s":{"kurz":10,"normal":10,"lang":10},"pause_fest":true}]},{"id":"rueckkehr","segmente":[{"id":"s062","art":"sprache","datei":"tr/62.634ca358.mp3","ms":2209,"text":"Slowly, you are coming back.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s063","art":"sprache","datei":"tr/63.1ee92a06.mp3","ms":2910,"text":"Feel your whole body again, lying here.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s064","art":"sprache","datei":"tr/64.3975244b.mp3","ms":1722,"text":"Hear the sounds around you.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s065","art":"sprache","datei":"tr/65.f5d6caf5.mp3","ms":3166,"text":"Move your fingers and toes, very slowly.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s066","art":"sprache","datei":"tr/66.757ea97e.mp3","ms":1867,"text":"Stretch, if you like.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s067","art":"sprache","datei":"tr/67.54d6f9f8.mp3","ms":3097,"text":"Roll onto your side and stay there for a moment.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"s068","art":"sprache","datei":"tr/68.91c1371c.mp3","ms":2771,"text":"Then slowly sit up and open your eyes.","in":["kurz","normal","lang"],"pause_s":{"kurz":1,"normal":2,"lang":3}},{"id":"glocke","art":"glocke","ton":"ende"}]}]}