"],"pause_s":{"normal":12,"lang":19}},{"id":"s043","art":"sprache","datei":"sw/41.08646abd.mp3","ms":2234,"text":"My breathing is calm and even.","in":["lang"],"pause_s":{"lang":19}},{"id":"s044","art":"sprache","datei":"sw/44.b6fe8ee1.mp3","ms":2196,"text":"Breathing happens by itself.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19}},{"id":"s045","art":"sprache","datei":"sw/44.b6fe8ee1.mp3","ms":2196,"text":"Breathing happens by itself.","in":["lang"],"pause_s":{"lang":19}},{"id":"st03","art":"stille","in":["normal","lang"],"dauer_s":{"normal":45.9,"lang":48}}]},{"id":"stirn","segmente":[{"id":"s046","art":"sprache","datei":"sw/46.269dc4cd.mp3","ms":2288,"text":"My forehead is pleasantly cool.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19}},{"id":"s047","art":"sprache","datei":"sw/46.269dc4cd.mp3","ms":2288,"text":"My forehead is pleasantly cool.","in":["lang"],"pause_s":{"lang":19}},{"id":"s048","art":"sprache","datei":"sw/6.f95c06e0.mp3","ms":1669,"text":"I am completely calm.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19}}]},{"id":"nachspueren","segmente":[{"id":"s049","art":"sprache","datei":"sw/49.87ddc2b4.mp3","ms":5044,"text":"Stay in this calm a little longer. Heavy, warm and calm.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"st04","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":33.7,"normal":45.9,"lang":48}},{"id":"s050","art":"sprache","datei":"sw/50.a9da4c69.mp3","ms":4270,"text":"If thoughts come, let them pass, and return to the phrases.","in":["normal","lang"],"pause_s":{"normal":4,"lang":6.5}},{"id":"st05","art":"stille","in":["normal","lang"],"dauer_s":{"normal":45.9,"lang":48}}]},{"id":"zuruecknehmen","segmente":[{"id":"s051","art":"sprache","datei":"sw/51.ff3cc13d.mp3","ms":3766,"text":"Now bring the exercise to a close, step by step.","in":["kurz","normal","lang"],"pause_s":{"kurz":1,"normal":2,"lang":3},"modus":"wach"},{"id":"s052","art":"sprache","datei":"sw/52.8d72c3b2.mp3","ms":4511,"text":"Arms firm. Make fists and bend your arms firmly.","in":["kurz","normal","lang"],"pause_s":{"kurz":3,"normal":3,"lang":3},"pause_fest":true,"modus":"wach"},{"id":"s053","art":"sprache","datei":"sw/53.137d1eb1.mp3","ms":1184,"text":"Breathe deeply.","in":["kurz","normal","lang"],"pause_s":{"kurz":3,"normal":3,"lang":3},"pause_fest":true,"modus":"wach"},{"id":"s054","art":"sprache","datei":"sw/54.320b23ff.mp3","ms":926,"text":"Eyes open.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":2,"lang":2},"pause_fest":true,"modus":"wach"},{"id":"s055","art":"sprache","datei":"sw/55.0fd2986b.mp3","ms":2215,"text":"Stretch, and get up slowly.","in":["kurz","normal","lang"],"pause_s":{"kurz":1,"normal":2,"lang":3},"modus":"wach"},{"id":"s056","art":"sprache","datei":"sw/56.bb2ca5a2.mp3","ms":7997,"text":"If you'd like to fall asleep now, simply let the phrases go. You don't need to firm your arms or open your eyes.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5},"pegel_db":-3,"modus":"schlaf"},{"id":"s057","art":"sprache","datei":"sw/57.05a12b44.mp3","ms":4299,"text":"Just stay lying here. There's nothing more you need to do.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5},"pegel_db":-5,"modus":"schlaf"},{"id":"s058","art":"sprache","datei":"sw/58.f972b621.mp3","ms":4271,"text":"I'll be quiet now. Rest. Good night.","in":["kurz","normal","lang"],"pause_s":{"kurz":1,"normal":2,"lang":3},"pegel_db":-7,"modus":"schlaf"},{"id":"st06","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":60,"normal":120,"lang":180},"ende_stille":true,"modus":"schlaf"},{"id":"glocke","art":"glocke","ton":"ende","modus":"wach"}]}]}