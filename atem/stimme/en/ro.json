{"format":1,"id":"ruheort","kurz":"ro","sprache":"en","richtung":"ltr","titel":"A calm place – a meadow","untertitel":"A guided imagery journey to a green meadow, with all your senses.","haltung":["liegen","sitzen_angelehnt"],"augen":"zu_oder_offen","ende":"glocke","schlaf_modus":false,"laengen":{"kurz":{"ziel_s":300},"normal":{"ziel_s":720},"lang":{"ziel_s":1200}},"kb":963,"abschnitte":[{"id":"ankommen","segmente":[{"id":"s001","art":"sprache","datei":"ro/1.12aff032.mp3","ms":3234,"text":"Lie down, or sit comfortably leaning back.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.3,"normal":3,"lang":5}},{"id":"s002","art":"sprache","datei":"ro/2.d496bf2a.mp3","ms":4789,"text":"Close your eyes if you like. You can open them at any time.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.3,"normal":3,"lang":5}},{"id":"s003","art":"sprache","datei":"ro/3.d34c7154.mp3","ms":4767,"text":"In a moment, you'll travel in your mind to a peaceful place, a meadow.","in":["kurz","normal","lang"],"pause_s":{"kurz":1.2,"normal":2,"lang":3}},{"id":"s004","art":"sprache","datei":"ro/4.d390b753.mp3","ms":7538,"text":"If you'd prefer a different place, the edge of a forest or a beach, go there instead. It's your choice.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.3,"normal":3,"lang":5}},{"id":"s005","art":"sprache","datei":"ro/5.60235c39.mp3","ms":7135,"text":"Let a few calm, long breaths flow out. Your breathing can slow down, without forcing it.","in":["kurz","normal","lang"],"pause_s":{"kurz":4.1,"normal":6,"lang":9.5}},{"id":"s006","art":"sprache","datei":"ro/6.8f7b6e5a.mp3","ms":3628,"text":"With each out-breath, your body becomes a little heavier.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}}]},{"id":"weg","segmente":[{"id":"s007","art":"sprache","datei":"ro/7.6527c838.mp3","ms":2964,"text":"Imagine you are walking along a narrow path.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":5,"lang":8}},{"id":"s008","art":"sprache","datei":"ro/8.2c2fff17.mp3","ms":2458,"text":"The ground beneath your feet is soft.","in":["normal","lang"],"pause_s":{"normal":5,"lang":8}},{"id":"s009","art":"sprache","datei":"ro/9.e3e6c2ea.mp3","ms":3177,"text":"Ahead of you, a wide green meadow opens up.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"st01","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":41.5,"normal":65,"lang":68.1}},{"id":"s010","art":"sprache","datei":"ro/10.7100c455.mp3","ms":4491,"text":"It's a pleasant day. Not too warm, not too cool.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}}]},{"id":"sinne","segmente":[{"id":"s011","art":"sprache","datei":"ro/11.b366fd14.mp3","ms":4072,"text":"Look around you. The grass is green and fresh.","in":["kurz","normal","lang"],"pause_s":{"kurz":6.4,"normal":9,"lang":14.5}},{"id":"s012","art":"sprache","datei":"ro/12.f46c0a34.mp3","ms":4864,"text":"Perhaps you see flowers. White, yellow, violet.","in":["normal","lang"],"pause_s":{"normal":9,"lang":14.5}},{"id":"s013","art":"sprache","datei":"ro/13.1641ea03.mp3","ms":2781,"text":"Above you, the sky is wide and open.","in":["kurz","normal","lang"],"pause_s":{"kurz":6.4,"normal":9,"lang":14.5}},{"id":"s014","art":"sprache","datei":"ro/14.7104e171.mp3","ms":2452,"text":"A few clouds drift slowly by.","in":["normal","lang"],"pause_s":{"normal":9,"lang":14.5}},{"id":"s015","art":"sprache","datei":"ro/15.fb6348cd.mp3","ms":2658,"text":"In the distance stands a row of trees.","in":["lang"],"pause_s":{"lang":11}},{"id":"st02","art":"stille","in":["normal","lang"],"dauer_s":{"normal":65,"lang":68.1}},{"id":"s016","art":"sprache","datei":"ro/16.5e199450.mp3","ms":3253,"text":"Listen. Perhaps you can hear birds.","in":["kurz","normal","lang"],"pause_s":{"kurz":6.4,"normal":9,"lang":14.5}},{"id":"s017","art":"sprache","datei":"ro/17.73e1ea3a.mp3","ms":2842,"text":"The soft rustling of the grass in the breeze.","in":["normal","lang"],"pause_s":{"normal":9,"lang":14.5}},{"id":"s018","art":"sprache","datei":"ro/18.94a274c8.mp3","ms":3888,"text":"Perhaps a bee is humming somewhere, or a stream is babbling.","in":["lang"],"pause_s":{"lang":11}},{"id":"s019","art":"sprache","datei":"ro/19.a661bd88.mp3","ms":4444,"text":"Breathe in the fresh air. It smells of grass and earth.","in":["normal","lang"],"pause_s":{"normal":9,"lang":14.5}},{"id":"s020","art":"sprache","datei":"ro/20.fa4cf993.mp3","ms":2835,"text":"Perhaps of blossoms too, or of rain.","in":["lang"],"pause_s":{"lang":11}},{"id":"s021","art":"sprache","datei":"ro/21.c13495d8.mp3","ms":2511,"text":"Feel the gentle breeze on your skin.","in":["kurz","normal","lang"],"pause_s":{"kurz":6.4,"normal":9,"lang":14.5}},{"id":"s022","art":"sprache","datei":"ro/22.de1b6f68.mp3","ms":2459,"text":"And the warmth of the sun on your face.","in":["kurz","normal","lang"],"pause_s":{"kurz":5.5,"normal":9,"lang":14.5}},{"id":"st03","art":"stille","in":["kurz"],"dauer_s":{"kurz":39.5}}]},{"id":"ruhen","segmente":[{"id":"s023","art":"sprache","datei":"ro/23.2e8abc7f.mp3","ms":3607,"text":"Find a nice spot in the meadow, and sit or lie down.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":5,"lang":8}},{"id":"s024","art":"sprache","datei":"ro/24.76fc33e5.mp3","ms":2161,"text":"Feel how the grass supports you.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s025","art":"sprache","datei":"ro/25.f2f9e96a.mp3","ms":4676,"text":"Here, there's nothing you need to do. You can simply rest.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"st04","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":41.5,"normal":65,"lang":68.1}},{"id":"s026","art":"sprache","datei":"ro/26.1cff3f47.mp3","ms":4340,"text":"The sun warms you pleasantly. The breeze is gentle.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s027","art":"sprache","datei":"ro/27.483484c0.mp3","ms":2665,"text":"Notice how calm your body can become.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"st05","art":"stille","in":["normal","lang"],"dauer_s":{"normal":65,"lang":68.1}},{"id":"s028","art":"sprache","datei":"ro/28.40216792.mp3","ms":3936,"text":"If thoughts come, let them drift on, like the clouds.","in":["kurz","normal","lang"],"pause_s":{"kurz":4.1,"normal":6,"lang":9.5}},{"id":"st06","art":"stille","in":["normal","lang"],"dauer_s":{"normal":65,"lang":68.1}},{"id":"s029","art":"sprache","datei":"ro/29.43027157.mp3","ms":2800,"text":"Listen once more to the birds and the wind.","in":["lang"],"pause_s":{"lang":9.5}},{"id":"st07","art":"stille","in":["lang"],"dauer_s":{"lang":68.1}},{"id":"s030","art":"sprache","datei":"ro/30.d44ca401.mp3","ms":6755,"text":"Perhaps you'd like to take a few steps barefoot through the grass. Cool and soft under your feet.","in":["lang"],"pause_s":{"lang":13}},{"id":"s031","art":"sprache","datei":"ro/31.6266e33a.mp3","ms":5341,"text":"At the edge of the meadow, a small stream flows. You can hear the water.","in":["lang"],"pause_s":{"lang":13}},{"id":"s032","art":"sprache","datei":"ro/32.44b963e8.mp3","ms":4040,"text":"Sit down on the bank and watch the water flowing calmly past.","in":["lang"],"pause_s":{"lang":13}},{"id":"st08","art":"stille","in":["lang"],"dauer_s":{"lang":68.1}},{"id":"s033","art":"sprache","datei":"ro/33.84b02aff.mp3","ms":2358,"text":"Then go back to your spot in the sun.","in":["lang"],"pause_s":{"lang":9.5}},{"id":"s034","art":"sprache","datei":"ro/34.ed0a17aa.mp3","ms":3551,"text":"Everything here is calm. You have time.","in":["lang"],"pause_s":{"lang":9.5}},{"id":"st09","art":"stille","in":["lang"],"dauer_s":{"lang":68.1}}]},{"id":"merken","segmente":[{"id":"s035","art":"sprache","datei":"ro/35.d8718ac3.mp3","ms":5729,"text":"Take in this place and remember it. The colors, the sounds, the air.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":5,"lang":8}},{"id":"s036","art":"sprache","datei":"ro/36.71ccbcb3.mp3","ms":3109,"text":"You can come back here in your mind at any time.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.9,"normal":4,"lang":6.5}},{"id":"s037","art":"sprache","datei":"ro/37.0f22cb25.mp3","ms":2752,"text":"Take a few more calm breaths in this place.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"st10","art":"stille","in":["normal","lang"],"dauer_s":{"normal":65,"lang":68.1}}]},{"id":"rueckweg","segmente":[{"id":"s038","art":"sprache","datei":"ro/38.b2e8c2e1.mp3","ms":3017,"text":"Now slowly get up and walk back to the path.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.9,"normal":4,"lang":6.5}},{"id":"s039","art":"sprache","datei":"ro/39.e37a17fe.mp3","ms":4131,"text":"With every step, you come back a little more to the room you are in.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.9,"normal":4,"lang":6.5}},{"id":"s040","art":"sprache","datei":"ro/40.a26c762b.mp3","ms":2608,"text":"Feel your body, lying or sitting.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.9,"normal":4,"lang":6.5}},{"id":"s041","art":"sprache","datei":"ro/41.dce4fea6.mp3","ms":2584,"text":"Breathe in and out a little more deeply.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.3,"normal":3,"lang":5}},{"id":"s042","art":"sprache","datei":"ro/42.af0e74a6.mp3","ms":3458,"text":"Move your fingers and toes. Stretch.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.9,"normal":4,"lang":6.5}},{"id":"s043","art":"sprache","datei":"ro/43.c2a9e8ed.mp3","ms":1951,"text":"Open your eyes when you're ready.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.3,"normal":3,"lang":5}},{"id":"s044","art":"sprache","datei":"ro/44.fed669fe.mp3","ms":2835,"text":"If you've been lying down, get up slowly.","in":["kurz","normal","lang"],"pause_s":{"kurz":1.2,"normal":2,"lang":3}},{"id":"glocke","art":"glocke","ton":"ende"}]}]}