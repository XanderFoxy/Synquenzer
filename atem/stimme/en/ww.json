{"format":1,"id":"was_mir_wichtig_ist","kurz":"ww","sprache":"en","richtung":"ltr","titel":"What matters to me","untertitel":"Think of one of your values and of a moment when you acted on it.","haltung":["sitzen"],"augen":"zu_oder_offen","ende":"glocke","schlaf_modus":false,"laengen":{"kurz":{"ziel_s":180},"normal":{"ziel_s":420},"lang":{"ziel_s":600}},"kb":381,"abschnitte":[{"id":"ankommen","segmente":[{"id":"s001","art":"sprache","datei":"ww/1.84599c89.mp3","ms":6549,"text":"Sit comfortably. Close your eyes if you like. You can stop at any time.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.6,"normal":3,"lang":6.1}},{"id":"s002","art":"sprache","datei":"ww/2.ac8c59f9.mp3","ms":2298,"text":"Take a few calm breaths in and out.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.9,"normal":5,"lang":9.7}}]},{"id":"wert","segmente":[{"id":"s003","art":"sprache","datei":"ww/3.0d9ac671.mp3","ms":3208,"text":"Think of something that truly matters to you in life.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.3,"normal":4,"lang":7.9}},{"id":"s004","art":"sprache","datei":"ww/4.2d421da7.mp3","ms":3419,"text":"For example your family, friendship or health.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.6,"normal":3,"lang":6.1}},{"id":"s005","art":"sprache","datei":"ww/5.e5f544f9.mp3","ms":4679,"text":"Or honesty, learning, creating something, or helping others.","in":["kurz","normal","lang"],"pause_s":{"kurz":4.6,"normal":6,"lang":11.5}},{"id":"s006","art":"sprache","datei":"ww/6.b4ae043d.mp3","ms":3042,"text":"Choose the value that means the most to you today.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"st01","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":41.5,"normal":65.8,"lang":65.5}},{"id":"s007","art":"sprache","datei":"ww/7.7f1a78fb.mp3","ms":4613,"text":"Why does it matter to you? Let the answer come in its own time.","in":["normal","lang"],"pause_s":{"normal":10,"lang":16}},{"id":"st02","art":"stille","in":["normal","lang"],"dauer_s":{"normal":65,"lang":59}}]},{"id":"erinnerung","segmente":[{"id":"s008","art":"sprache","datei":"ww/8.44afc4b3.mp3","ms":5661,"text":"Remember a moment when you acted on this value. Something small counts too.","in":["kurz","normal","lang"],"pause_s":{"kurz":4.6,"normal":6,"lang":11.5}},{"id":"s009","art":"sprache","datei":"ww/9.28e01a9b.mp3","ms":4172,"text":"Maybe it was a conversation, a helping hand, or a decision.","in":["normal","lang"],"pause_s":{"normal":6,"lang":11.5}},{"id":"s010","art":"sprache","datei":"ww/10.4f0bfcc3.mp3","ms":2884,"text":"Where were you? What did you do?","in":["kurz","normal","lang"],"pause_s":{"kurz":6.5,"normal":8,"lang":15.8}},{"id":"s011","art":"sprache","datei":"ww/11.1afe611c.mp3","ms":1671,"text":"Notice how that felt.","in":["normal","lang"],"pause_s":{"normal":8,"lang":15.8}},{"id":"s012","art":"sprache","datei":"ww/12.c94f72a6.mp3","ms":2710,"text":"What does this moment say about who you are?","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"st03","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":40,"normal":65.8,"lang":62}},{"id":"s013","art":"sprache","datei":"ww/13.8455fb8a.mp3","ms":2702,"text":"Let this moment linger a little longer.","in":["lang"],"pause_s":{"lang":13}},{"id":"st04","art":"stille","in":["lang"],"dauer_s":{"lang":62}}]},{"id":"schritt","segmente":[{"id":"s014","art":"sprache","datei":"ww/14.08306316.mp3","ms":3999,"text":"What small step could you take today or tomorrow in this spirit?","in":["kurz","normal","lang"],"pause_s":{"kurz":7.8,"normal":10,"lang":19.4}},{"id":"s015","art":"sprache","datei":"ww/15.2bd8fe89.mp3","ms":1980,"text":"Imagine yourself taking it.","in":["lang"],"pause_s":{"lang":19.4}},{"id":"s016","art":"sprache","datei":"ww/16.6f393e4a.mp3","ms":1928,"text":"What do you need to make it easier?","in":["normal","lang"],"pause_s":{"normal":10,"lang":16}},{"id":"st05","art":"stille","in":["normal","lang"],"dauer_s":{"normal":65,"lang":59}}]},{"id":"rueckkehr","segmente":[{"id":"s017","art":"sprache","datei":"ww/17.799557d4.mp3","ms":5077,"text":"Your values can give you steady ground, even when something is difficult right now.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.3,"normal":4,"lang":7.9}},{"id":"s018","art":"sprache","datei":"ww/18.9615a802.mp3","ms":3452,"text":"Take one deep breath in and out, and open your eyes.","in":["kurz","normal","lang"],"pause_s":{"kurz":1.3,"normal":2,"lang":3.6}},{"id":"glocke","art":"glocke","ton":"ende"}]}]}