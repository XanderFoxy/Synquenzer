{"format":1,"id":"freundlich_mit_mir","kurz":"fm","sprache":"en","richtung":"ltr","titel":"Being kind to myself","untertitel":"In a difficult moment, speak to yourself kindly, the way you would to a good friend.","haltung":["sitzen","liegen"],"augen":"zu_oder_offen","ende":"glocke","schlaf_modus":false,"laengen":{"kurz":{"ziel_s":180},"normal":{"ziel_s":600},"lang":{"ziel_s":900}},"kb":825,"abschnitte":[{"id":"ankommen","segmente":[{"id":"s001","art":"sprache","datei":"fm/1.6db17291.mp3","ms":2398,"text":"Sit comfortably, or lie down.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s002","art":"sprache","datei":"fm/2.253048b7.mp3","ms":4468,"text":"Close your eyes if you like. You can stop at any time.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s003","art":"sprache","datei":"fm/3.dbc9d430.mp3","ms":4885,"text":"Notice how you are sitting or lying. Let your shoulders drop.","in":["normal","lang"],"pause_s":{"normal":4,"lang":6.5}},{"id":"s004","art":"sprache","datei":"fm/4.3d260b1b.mp3","ms":2332,"text":"Take a few calm breaths in and out.","in":["kurz","normal","lang"],"pause_s":{"kurz":3,"normal":5,"lang":8}}]},{"id":"situation","segmente":[{"id":"s005","art":"sprache","datei":"fm/5.849c45c7.mp3","ms":6489,"text":"Think of a situation that's on your mind at the moment. Something that is a little difficult.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s006","art":"sprache","datei":"fm/6.7e429550.mp3","ms":4727,"text":"Don't choose the hardest thing. Something in the middle is enough.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s007","art":"sprache","datei":"fm/7.ff5d745a.mp3","ms":5771,"text":"Briefly picture the situation. Where are you? What happened?","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s008","art":"sprache","datei":"fm/8.8353891f.mp3","ms":6613,"text":"Notice where you feel it in your body. Perhaps in your belly, your chest or your throat.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"st01","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":32.9,"normal":56,"lang":63.8}},{"id":"s009","art":"sprache","datei":"fm/9.b8f6a415.mp3","ms":4576,"text":"If it becomes too much, open your eyes and feel your feet on the floor.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}}]},{"id":"bemerken","segmente":[{"id":"s010","art":"sprache","datei":"fm/10.3b435520.mp3","ms":3859,"text":"Now say to yourself silently: This is hard right now.","in":["kurz","normal","lang"],"pause_s":{"kurz":3,"normal":5,"lang":8}},{"id":"s011","art":"sprache","datei":"fm/11.14887e6e.mp3","ms":4531,"text":"Or in your own words: This hurts. This is stressful.","in":["normal","lang"],"pause_s":{"normal":5,"lang":8}}]},{"id":"nicht_allein","segmente":[{"id":"s012","art":"sprache","datei":"fm/12.e6207a71.mp3","ms":5656,"text":"And then: Many people go through things like this. I'm not alone in this.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"s013","art":"sprache","datei":"fm/13.b5ad49b9.mp3","ms":3418,"text":"Others feel much the same in a situation like this.","in":["normal","lang"],"pause_s":{"normal":5,"lang":8}},{"id":"st02","art":"stille","in":["normal","lang"],"dauer_s":{"normal":56,"lang":63.8}}]},{"id":"freundlich","segmente":[{"id":"s014","art":"sprache","datei":"fm/14.0a34915a.mp3","ms":5032,"text":"If you like, place a hand on your heart, on your belly, or on your cheek.","in":["kurz","normal","lang"],"pause_s":{"kurz":3,"normal":5,"lang":8}},{"id":"s015","art":"sprache","datei":"fm/15.76d6a9f7.mp3","ms":1959,"text":"Feel the warmth of your hand.","in":["normal","lang"],"pause_s":{"normal":5,"lang":8}},{"id":"s016","art":"sprache","datei":"fm/16.be4b0185.mp3","ms":5596,"text":"And ask yourself: What would I say to a good friend who was feeling the way I feel right now?","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s017","art":"sprache","datei":"fm/17.deecfe97.mp3","ms":5733,"text":"Perhaps: You're doing your best. Or: It's okay that this is hard.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s018","art":"sprache","datei":"fm/18.af885be4.mp3","ms":4215,"text":"Now say these words to yourself. In a warm tone.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"st03","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":32.9,"normal":56,"lang":62}},{"id":"s019","art":"sprache","datei":"fm/19.c54ab7aa.mp3","ms":5665,"text":"It doesn't have to feel good right away. What matters is the kind intention.","in":["normal","lang"],"pause_s":{"normal":5,"lang":8}},{"id":"s020","art":"sprache","datei":"fm/20.53a24a0e.mp3","ms":4951,"text":"Repeat the words as often as you like. Slowly and kindly.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"st04","art":"stille","in":["normal","lang"],"dauer_s":{"normal":56,"lang":63.8}},{"id":"s021","art":"sprache","datei":"fm/21.a83dd2c9.mp3","ms":6463,"text":"Notice whether anything changes in your body. Or not. Either is fine.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"st05","art":"stille","in":["normal","lang"],"dauer_s":{"normal":56,"lang":63.8}},{"id":"s022","art":"sprache","datei":"fm/22.eb25a361.mp3","ms":5914,"text":"If it's hard to be kind to yourself, that's okay. Many people know this feeling.","in":["lang"],"pause_s":{"lang":8}},{"id":"s023","art":"sprache","datei":"fm/23.ed1a081b.mp3","ms":4002,"text":"Then imagine someone who cares about you saying these words to you.","in":["lang"],"pause_s":{"lang":13}},{"id":"st06","art":"stille","in":["lang"],"dauer_s":{"lang":62}}]},{"id":"satz","segmente":[{"id":"s024","art":"sprache","datei":"fm/24.b65234e8.mp3","ms":6425,"text":"Find a short phrase you can take with you. One that feels true and isn't exaggerated.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s025","art":"sprache","datei":"fm/25.ed0ef4eb.mp3","ms":4035,"text":"For example: It's okay to make mistakes and learn from them.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s026","art":"sprache","datei":"fm/26.7036e78a.mp3","ms":2411,"text":"Or: I stand by myself.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"st07","art":"stille","in":["normal","lang"],"dauer_s":{"normal":56,"lang":63.8}},{"id":"s027","art":"sprache","datei":"fm/27.76a6a46c.mp3","ms":4096,"text":"Repeat your phrase a few more times, in rhythm with your breath.","in":["lang"],"pause_s":{"lang":9.5}},{"id":"st08","art":"stille","in":["lang"],"dauer_s":{"lang":63.8}}]},{"id":"rueckkehr","segmente":[{"id":"s028","art":"sprache","datei":"fm/28.0f467dd3.mp3","ms":2147,"text":"Now let go of the situation.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s029","art":"sprache","datei":"fm/29.3ae75e17.mp3","ms":3557,"text":"Feel your breath again, and how you are sitting or lying.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s030","art":"sprache","datei":"fm/30.df0d43ae.mp3","ms":2188,"text":"Take one deep breath in and out.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s031","art":"sprache","datei":"fm/31.6c090f77.mp3","ms":1951,"text":"Open your eyes when you're ready.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s032","art":"sprache","datei":"fm/32.f1b72186.mp3","ms":2843,"text":"If you've been lying down, get up slowly.","in":["kurz","normal","lang"],"pause_s":{"kurz":1,"normal":2,"lang":3}},{"id":"glocke","art":"glocke","ton":"ende"}]}]}