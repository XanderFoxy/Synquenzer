{"format":1,"id":"einschlafen","kurz":"es","sprache":"en","richtung":"ltr","titel":"Winding down in bed","untertitel":"Set the day aside, relax the muscles, breathe out slowly. The voice grows quieter and ends without a sound.","haltung":["im_bett"],"augen":"zu_oder_offen","ende":"still","schlaf_modus":false,"laengen":{"kurz":{"ziel_s":480},"normal":{"ziel_s":900},"lang":{"ziel_s":1500}},"kb":665,"abschnitte":[{"id":"ankommen","segmente":[{"id":"s001","art":"sprache","datei":"es/1.1a08566b.mp3","ms":4933,"text":"Lie down the way you usually fall asleep. Turn off the light.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s002","art":"sprache","datei":"es/2.56798d7b.mp3","ms":3656,"text":"Put your phone down so you're no longer looking at the screen.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s003","art":"sprache","datei":"es/3.4c23e0aa.mp3","ms":10295,"text":"There's nothing more you need to get done now. Not even falling asleep. You can simply rest. And you can stop at any time.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}}]},{"id":"ablegen","segmente":[{"id":"s004","art":"sprache","datei":"es/4.651a6b4f.mp3","ms":7166,"text":"Are things for tomorrow still going through your mind? Imagine putting them in a box next to your bed.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"s005","art":"sprache","datei":"es/5.cc741e95.mp3","ms":2622,"text":"Tomorrow, you can take them out again.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"s006","art":"sprache","datei":"es/6.60d6a3eb.mp3","ms":5092,"text":"If something keeps going around in your head, you can also jot it down quickly.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}}]},{"id":"muskeln","segmente":[{"id":"s007","art":"sprache","datei":"es/7.fc6c4ab0.mp3","ms":4816,"text":"Close your hands into fists for a moment. Just lightly.","in":["kurz","normal","lang"],"pause_s":{"kurz":4,"normal":4,"lang":4},"pause_fest":true},{"id":"s008","art":"sprache","datei":"es/8.038ffaf9.mp3","ms":1056,"text":"And let go.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s009","art":"sprache","datei":"es/9.cfa1692d.mp3","ms":3166,"text":"Lift your shoulders a little toward your ears.","in":["kurz","normal","lang"],"pause_s":{"kurz":4,"normal":4,"lang":4},"pause_fest":true},{"id":"s010","art":"sprache","datei":"es/10.f92e746c.mp3","ms":1343,"text":"And let them drop.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s011","art":"sprache","datei":"es/11.c209403f.mp3","ms":2052,"text":"Scrunch up your face a little.","in":["normal","lang"],"pause_s":{"normal":4,"lang":4},"pause_fest":true},{"id":"s012","art":"sprache","datei":"es/12.a86254e6.mp3","ms":1327,"text":"And let it soften.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"s013","art":"sprache","datei":"es/13.cf79bd10.mp3","ms":2704,"text":"Notice how your muscles are looser now.","in":["kurz","normal","lang"],"pause_s":{"kurz":6,"normal":10,"lang":16}}]},{"id":"atem","pegel_db":-1,"segmente":[{"id":"s014","art":"sprache","datei":"es/14.bb698404.mp3","ms":3668,"text":"Feel your breath. It flows on its own.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13},"pegel_db":-1},{"id":"s015","art":"sprache","datei":"es/15.b227553e.mp3","ms":6114,"text":"Let the out-breath become a little longer than the in-breath. Without any effort.","in":["kurz","normal","lang"],"pause_s":{"kurz":6,"normal":10,"lang":16},"pegel_db":-1},{"id":"s016","art":"sprache","datei":"es/16.7d664b57.mp3","ms":4243,"text":"With each out-breath, you sink a little deeper into the mattress.","in":["kurz","normal","lang"],"pause_s":{"kurz":7,"normal":12,"lang":19},"pegel_db":-1},{"id":"st01","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":60.8,"normal":63,"lang":101}},{"id":"s017","art":"sprache","datei":"es/17.80a1a3ba.mp3","ms":4954,"text":"There's no need to count. Just let the breath be slow and soft.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19},"pegel_db":-1},{"id":"st02","art":"stille","in":["normal","lang"],"dauer_s":{"normal":63,"lang":101}}]},{"id":"schwere","pegel_db":-3,"segmente":[{"id":"s018","art":"sprache","datei":"es/18.577e8f94.mp3","ms":2065,"text":"Your feet are heavy and warm.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19},"pegel_db":-3},{"id":"s019","art":"sprache","datei":"es/19.fd6b3fd3.mp3","ms":1451,"text":"Your legs are heavy.","in":["kurz","normal","lang"],"pause_s":{"kurz":7,"normal":12,"lang":19},"pegel_db":-3},{"id":"s020","art":"sprache","datei":"es/20.e522c272.mp3","ms":2128,"text":"Your hands are heavy and warm.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19},"pegel_db":-3},{"id":"s021","art":"sprache","datei":"es/21.643e2ca8.mp3","ms":1459,"text":"Your arms are heavy.","in":["kurz","normal","lang"],"pause_s":{"kurz":7,"normal":12,"lang":19},"pegel_db":-3},{"id":"s022","art":"sprache","datei":"es/22.3edbf779.mp3","ms":2328,"text":"Your back sinks into the mattress.","in":["lang"],"pause_s":{"lang":19},"pegel_db":-3},{"id":"s023","art":"sprache","datei":"es/23.5d17af86.mp3","ms":2373,"text":"Your shoulders are soft and heavy.","in":["lang"],"pause_s":{"lang":19},"pegel_db":-3},{"id":"s024","art":"sprache","datei":"es/24.1ac33b20.mp3","ms":2612,"text":"Your head rests heavily on the pillow.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19},"pegel_db":-3},{"id":"s025","art":"sprache","datei":"es/25.d2204b43.mp3","ms":1509,"text":"Your face is soft.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19},"pegel_db":-3},{"id":"s026","art":"sprache","datei":"es/26.15337dc9.mp3","ms":2537,"text":"Your whole body is heavy and warm.","in":["kurz","normal","lang"],"pause_s":{"kurz":8.5,"normal":14,"lang":22.5},"pegel_db":-3},{"id":"st03","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":60.8,"normal":61,"lang":97.5}}]},{"id":"gedanken","pegel_db":-5,"segmente":[{"id":"s027","art":"sprache","datei":"es/27.df6abd9d.mp3","ms":6505,"text":"If thoughts come, that's okay. Let them drift past, like clouds in the night.","in":["kurz","normal","lang"],"pause_s":{"kurz":7,"normal":12,"lang":19},"pegel_db":-5},{"id":"s028","art":"sprache","datei":"es/28.fb767e73.mp3","ms":4222,"text":"And return to the breath. To the slow out-breath.","in":["kurz","normal","lang"],"pause_s":{"kurz":7,"normal":12,"lang":19},"pegel_db":-5},{"id":"st04","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":60.8,"normal":63,"lang":101}},{"id":"s029","art":"sprache","datei":"es/29.98e6824a.mp3","ms":2352,"text":"You are warm and snug in your bed.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19},"pegel_db":-5},{"id":"s030","art":"sprache","datei":"es/30.427027b4.mp3","ms":3408,"text":"You can let go now. The day is done.","in":["normal","lang"],"pause_s":{"normal":12,"lang":19},"pegel_db":-5},{"id":"st05","art":"stille","in":["normal","lang"],"dauer_s":{"normal":63,"lang":101}},{"id":"s031","art":"sprache","datei":"es/31.71d16a12.mp3","ms":1970,"text":"Nothing needs to happen now.","in":["lang"],"pause_s":{"lang":19},"pegel_db":-5},{"id":"st06","art":"stille","in":["lang"],"dauer_s":{"lang":101}}]},{"id":"ende","pegel_db":-7,"segmente":[{"id":"s032","art":"sprache","datei":"es/32.92c1057b.mp3","ms":4633,"text":"I'll be quiet now. Just stay where you are and rest.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5},"pegel_db":-7},{"id":"s033","art":"sprache","datei":"es/33.2020934d.mp3","ms":859,"text":"Good night.","in":["kurz","normal","lang"],"pause_s":{"kurz":1,"normal":2,"lang":3},"pegel_db":-7},{"id":"st07","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":121.6,"normal":220,"lang":318.8},"ende_stille":true}]}]}