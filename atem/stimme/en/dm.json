{"format":1,"id":"drei_minuten_pause","kurz":"dm","sprache":"en","richtung":"ltr","titel":"Three-minute pause","untertitel":"Three short steps: notice what is here; gather on the breath; widen to the whole body.","haltung":["sitzen"],"augen":"zu_oder_offen","ende":"glocke","schlaf_modus":false,"laengen":{"kurz":{"ziel_s":180},"normal":{"ziel_s":300},"lang":null},"kb":398,"abschnitte":[{"id":"ankommen","segmente":[{"id":"s001","art":"sprache","datei":"dm/1.758822ea.mp3","ms":2765,"text":"Sit upright, with your feet on the floor.","in":["kurz","normal"],"pause_s":{"kurz":1,"normal":2}},{"id":"s002","art":"sprache","datei":"dm/2.cbcd3055.mp3","ms":4416,"text":"Close your eyes if you like. You can stop at any time.","in":["kurz","normal"],"pause_s":{"kurz":1,"normal":2}}]},{"id":"wahrnehmen","segmente":[{"id":"s003","art":"sprache","datei":"dm/3.24eff5ad.mp3","ms":2526,"text":"Step one: What is here right now?","in":["kurz","normal"],"pause_s":{"kurz":2,"normal":3}},{"id":"s004","art":"sprache","datei":"dm/4.f5cf2aaf.mp3","ms":5155,"text":"What thoughts are going through your mind? You don't need to do anything with them.","in":["kurz","normal"],"pause_s":{"kurz":3.5,"normal":6}},{"id":"s005","art":"sprache","datei":"dm/5.28e9a427.mp3","ms":5228,"text":"What feelings are here? Pleasant, unpleasant, or neither.","in":["kurz","normal"],"pause_s":{"kurz":3.5,"normal":6}},{"id":"s006","art":"sprache","datei":"dm/6.61adaa9e.mp3","ms":5405,"text":"And what do you feel in your body? Tension, warmth, tiredness?","in":["kurz","normal"],"pause_s":{"kurz":3.5,"normal":6}},{"id":"st01","art":"stille","in":["kurz","normal"],"dauer_s":{"kurz":29.2,"normal":25.8}},{"id":"s007","art":"sprache","datei":"dm/7.535558b2.mp3","ms":3460,"text":"Simply notice what is here, without changing it.","in":["normal"],"pause_s":{"normal":6}},{"id":"st02","art":"stille","in":["normal"],"dauer_s":{"normal":25.8}}]},{"id":"sammeln","segmente":[{"id":"s008","art":"sprache","datei":"dm/8.7c539239.mp3","ms":3262,"text":"Step two: Gather your attention on the breath.","in":["kurz","normal"],"pause_s":{"kurz":2,"normal":3}},{"id":"s009","art":"sprache","datei":"dm/9.1133b507.mp3","ms":4762,"text":"If focusing on the breath is unpleasant, feel your feet on the floor instead.","in":["kurz","normal"],"pause_s":{"kurz":2,"normal":3}},{"id":"s010","art":"sprache","datei":"dm/10.d3dbc596.mp3","ms":4213,"text":"Feel your belly rise as you breathe in, and fall as you breathe out.","in":["kurz","normal"],"pause_s":{"kurz":3.5,"normal":6}},{"id":"s011","art":"sprache","datei":"dm/11.0670ef6f.mp3","ms":2238,"text":"Follow one breath after another.","in":["kurz","normal"],"pause_s":{"kurz":3.5,"normal":6}},{"id":"st03","art":"stille","in":["kurz","normal"],"dauer_s":{"kurz":29.2,"normal":25.8}},{"id":"s012","art":"sprache","datei":"dm/12.536b61d1.mp3","ms":2748,"text":"When thoughts come, return to the breath.","in":["normal"],"pause_s":{"normal":6}},{"id":"st04","art":"stille","in":["normal"],"dauer_s":{"normal":25.8}}]},{"id":"weiten","segmente":[{"id":"s013","art":"sprache","datei":"dm/13.28828a23.mp3","ms":4446,"text":"Step three: Let your attention widen to include your whole body.","in":["kurz","normal"],"pause_s":{"kurz":2.5,"normal":4}},{"id":"s014","art":"sprache","datei":"dm/14.fb667cea.mp3","ms":4603,"text":"How you are sitting. Your posture. Your face.","in":["kurz","normal"],"pause_s":{"kurz":3.5,"normal":6}},{"id":"s015","art":"sprache","datei":"dm/15.439ef22a.mp3","ms":1486,"text":"The whole body breathing.","in":["kurz","normal"],"pause_s":{"kurz":3.5,"normal":6}},{"id":"st05","art":"stille","in":["kurz","normal"],"dauer_s":{"kurz":29.2,"normal":25.8}},{"id":"s016","art":"sprache","datei":"dm/16.8ea8e7d1.mp3","ms":4264,"text":"If there's tension anywhere, breathe into it and let it soften a little.","in":["normal"],"pause_s":{"normal":6}},{"id":"st06","art":"stille","in":["normal"],"dauer_s":{"normal":25.8}}]},{"id":"weiter","segmente":[{"id":"s017","art":"sprache","datei":"dm/17.010219b2.mp3","ms":5833,"text":"Now open your eyes. And take this awareness with you into whatever comes next.","in":["kurz","normal"],"pause_s":{"kurz":1,"normal":1}},{"id":"glocke","art":"glocke","ton":"ende"}]}]}