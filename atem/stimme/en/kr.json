{"format":1,"id":"koerperreise","kurz":"kr","sprache":"en","richtung":"ltr","titel":"Body scan, lying down","untertitel":"Move your attention slowly through the body, from the feet up to the head.","haltung":["liegen","im_bett"],"augen":"zu_oder_offen","ende":"glocke","schlaf_modus":true,"laengen":{"kurz":{"ziel_s":300},"normal":{"ziel_s":720},"lang":{"ziel_s":1500}},"kb":1219,"abschnitte":[{"id":"ankommen","segmente":[{"id":"s001","art":"sprache","datei":"kr/1.b0012ce4.mp3","ms":7126,"text":"Lie down comfortably on your back. A pillow under your head and another under your knees can help.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s002","art":"sprache","datei":"kr/2.50b41d56.mp3","ms":3054,"text":"Let your arms rest loosely by your sides.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s003","art":"sprache","datei":"kr/3.ced59f3b.mp3","ms":5175,"text":"Close your eyes if you like. Keeping them open is just as fine.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s004","art":"sprache","datei":"kr/4.714663ca.mp3","ms":5642,"text":"You can stop at any time. And you can skip any area that doesn't feel good.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s005","art":"sprache","datei":"kr/5.384faf98.mp3","ms":5760,"text":"In this practice, there's nothing to change. You simply feel what is there.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s006","art":"sprache","datei":"kr/6.c7628624.mp3","ms":4053,"text":"Even if you can't feel anything in some places, that's fine.","in":["normal","lang"],"pause_s":{"normal":3,"lang":5}},{"id":"s007","art":"sprache","datei":"kr/7.7cfdc629.mp3","ms":3783,"text":"Take your time. There's nothing you need to achieve.","in":["lang"],"pause_s":{"lang":6.5}},{"id":"s008","art":"sprache","datei":"kr/8.2b7feb4a.mp3","ms":5242,"text":"First, feel your breath. How it comes and goes by itself.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"s009","art":"sprache","datei":"kr/9.3ce0eac4.mp3","ms":7665,"text":"And feel where your body touches the surface: your heels, calves, pelvis, back, and the back of your head.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"s010","art":"sprache","datei":"kr/10.fd28bc8e.mp3","ms":2246,"text":"Allow yourself to become heavy.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"st01","art":"stille","in":["normal","lang"],"dauer_s":{"normal":41.9,"lang":91.6}}]},{"id":"fuesse","segmente":[{"id":"s011","art":"sprache","datei":"kr/11.4c2e4a80.mp3","ms":2926,"text":"Let your attention travel down to your feet.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s012","art":"sprache","datei":"kr/12.66534d14.mp3","ms":3687,"text":"To your toes, the soles of your feet, your heels.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s013","art":"sprache","datei":"kr/13.ec5ef5d3.mp3","ms":5259,"text":"Perhaps you notice warmth or coolness, a tingling, or the touch of a blanket.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"s014","art":"sprache","datei":"kr/14.72901ebb.mp3","ms":3060,"text":"Now feel the tops of your feet and your ankles.","in":["lang"],"pause_s":{"lang":13}},{"id":"s015","art":"sprache","datei":"kr/15.71f18ef7.mp3","ms":6567,"text":"If you like, imagine the breath flowing all the way down into your feet. And back out again.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"st02","art":"stille","in":["lang"],"dauer_s":{"lang":91.6}}]},{"id":"beine","segmente":[{"id":"s016","art":"sprache","datei":"kr/16.6c04e75a.mp3","ms":4468,"text":"Move on to your lower legs. Your calves and your shins.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"s017","art":"sprache","datei":"kr/17.a79db47b.mp3","ms":966,"text":"To your knees.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s018","art":"sprache","datei":"kr/18.3eaa990f.mp3","ms":5132,"text":"And to your thighs. Front, back, inside and outside.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"s019","art":"sprache","datei":"kr/19.24c3a7ce.mp3","ms":6440,"text":"Feel your right leg. And then your left. They may feel different from each other.","in":["lang"],"pause_s":{"lang":13}},{"id":"s020","art":"sprache","datei":"kr/20.518474a5.mp3","ms":4133,"text":"Now feel both legs as a whole, from your feet up to your hips.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"st03","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":39.4,"normal":41.9,"lang":91.6}}]},{"id":"rumpf","segmente":[{"id":"s021","art":"sprache","datei":"kr/21.b12aba01.mp3","ms":3465,"text":"Let your attention move on to your pelvis and buttocks.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"s022","art":"sprache","datei":"kr/22.1e97affe.mp3","ms":4939,"text":"To your belly. Perhaps you can feel it rise and fall with the breath.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s023","art":"sprache","datei":"kr/23.1265abd1.mp3","ms":1262,"text":"To your lower back.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s024","art":"sprache","datei":"kr/24.2536bb93.mp3","ms":3048,"text":"To your upper back, between the shoulder blades.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"s025","art":"sprache","datei":"kr/25.05122e30.mp3","ms":3546,"text":"To your chest. The breath moves here too.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"s026","art":"sprache","datei":"kr/26.1d953797.mp3","ms":7027,"text":"If you notice tension anywhere, breathe gently into that area. You don't have to make it go away.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"st04","art":"stille","in":["normal","lang"],"dauer_s":{"normal":41.9,"lang":91.6}}]},{"id":"arme","segmente":[{"id":"s027","art":"sprache","datei":"kr/27.622c00c6.mp3","ms":7282,"text":"Now guide your attention to your hands. To your fingertips, your palms, the backs of your hands.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s028","art":"sprache","datei":"kr/28.5e163e5d.mp3","ms":1930,"text":"To your wrists and forearms.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s029","art":"sprache","datei":"kr/29.2fd03fce.mp3","ms":2153,"text":"To your elbows and upper arms.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s030","art":"sprache","datei":"kr/30.3ca473aa.mp3","ms":4692,"text":"And to your shoulders. If they want to drop a little, let them.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s031","art":"sprache","datei":"kr/31.daebb093.mp3","ms":4784,"text":"Feel both arms at the same time, from your fingertips to your shoulders.","in":["lang"],"pause_s":{"lang":13}},{"id":"st05","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":39.4,"normal":41.9,"lang":91.6}}]},{"id":"kopf","segmente":[{"id":"s032","art":"sprache","datei":"kr/32.687f0795.mp3","ms":1957,"text":"Now feel your neck and throat.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s033","art":"sprache","datei":"kr/33.04fecc36.mp3","ms":4002,"text":"Your jaw. Perhaps your teeth can part slightly.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s034","art":"sprache","datei":"kr/34.60b4524d.mp3","ms":2931,"text":"Your lips, your cheeks, your nose.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s035","art":"sprache","datei":"kr/35.e22f6080.mp3","ms":3324,"text":"Feel the air flowing in and out at your nostrils.","in":["lang"],"pause_s":{"lang":13}},{"id":"s036","art":"sprache","datei":"kr/36.c56ac117.mp3","ms":1732,"text":"Your eyes and eyelids.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s037","art":"sprache","datei":"kr/37.059bd7f8.mp3","ms":1917,"text":"Your forehead and temples.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s038","art":"sprache","datei":"kr/38.addbf1c2.mp3","ms":2734,"text":"And your whole head, right up to the crown.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"st06","art":"stille","in":["normal","lang"],"dauer_s":{"normal":41.9,"lang":91.6}}]},{"id":"ganz","segmente":[{"id":"s039","art":"sprache","datei":"kr/39.92001575.mp3","ms":4909,"text":"Now feel your whole body at once. From your feet to your head.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"s040","art":"sprache","datei":"kr/40.817cc651.mp3","ms":3086,"text":"How it rests. How it breathes.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"s041","art":"sprache","datei":"kr/41.27a9dd3e.mp3","ms":3164,"text":"Simply being here, just as you are right now.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"st07","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":39.4,"normal":41.9,"lang":91.6}},{"id":"s042","art":"sprache","datei":"kr/42.68ee37d2.mp3","ms":5296,"text":"If your mind has wandered, that's fine. Just come back to feeling.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"st08","art":"stille","in":["normal","lang"],"dauer_s":{"normal":41.9,"lang":91.6}},{"id":"s043","art":"sprache","datei":"kr/43.f452264d.mp3","ms":3461,"text":"The breath flows through your whole body, all on its own.","in":["lang"],"pause_s":{"lang":9.5}},{"id":"st09","art":"stille","in":["lang"],"dauer_s":{"lang":91.6}}]},{"id":"rueckkehr","segmente":[{"id":"s044","art":"sprache","datei":"kr/44.81495b3d.mp3","ms":2829,"text":"Slowly, the practice comes to an end.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s045","art":"sprache","datei":"kr/45.fd8057bd.mp3","ms":5292,"text":"If you'd like to sleep, just stay as you are. There's nothing more to do.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5},"modus":"wach"},{"id":"s046","art":"sprache","datei":"kr/46.b19f71b8.mp3","ms":4163,"text":"If you'd like to get up, breathe in and out a little more deeply.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5},"modus":"wach"},{"id":"s047","art":"sprache","datei":"kr/47.a15adbd1.mp3","ms":4497,"text":"Move your fingers and toes. Stretch, if you like.","in":["kurz","normal","lang"],"pause_s":{"kurz":3,"normal":5,"lang":8},"modus":"wach"},{"id":"s048","art":"sprache","datei":"kr/48.4e54a319.mp3","ms":1948,"text":"Open your eyes when you're ready.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5},"modus":"wach"},{"id":"s049","art":"sprache","datei":"kr/49.ed7caf70.mp3","ms":2644,"text":"Roll onto your side and get up slowly.","in":["kurz","normal","lang"],"pause_s":{"kurz":1,"normal":2,"lang":3},"modus":"wach"},{"id":"s050","art":"sprache","datei":"kr/50.b7542de9.mp3","ms":4264,"text":"Just stay lying here. There's nothing more you need to do.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5},"pegel_db":-5,"modus":"schlaf"},{"id":"s051","art":"sprache","datei":"kr/51.3cd989e6.mp3","ms":4272,"text":"I'll be quiet now. Rest. Good night.","in":["kurz","normal","lang"],"pause_s":{"kurz":1,"normal":2,"lang":3},"pegel_db":-7,"modus":"schlaf"},{"id":"st10","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":60,"normal":120,"lang":180},"ende_stille":true,"modus":"schlaf"},{"id":"glocke","art":"glocke","ton":"ende","modus":"wach"}]}]}