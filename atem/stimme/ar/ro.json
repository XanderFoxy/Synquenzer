":9.5}},{"id":"st06","art":"stille","in":["normal","lang"],"dauer_s":{"normal":62.2,"lang":65.4}},{"id":"s029","art":"sprache","datei":"ro/29.b373da2c.mp3","ms":3977,"text":"أصغِ مرّةً أخرى إلى العصافير، وإلى النسيم.","in":["lang"],"pause_s":{"lang":9.5}},{"id":"st07","art":"stille","in":["lang"],"dauer_s":{"lang":65.4}},{"id":"s030","art":"sprache","datei":"ro/30.ddd02237.mp3","ms":7699,"text":"ربما تحبّ أن تمشي حافيًا بضع خطواتٍ على العشب. باردٌ وناعمٌ تحت قدميك.","in":["lang"],"pause_s":{"lang":13}},{"id":"s031","art":"sprache","datei":"ro/31.276a4d84.mp3","ms":5667,"text":"على طرف المَرْج يجري جدولٌ صغير. تسمع صوت الماء.","in":["lang"],"pause_s":{"lang":13}},{"id":"s032","art":"sprache","datei":"ro/32.45a84e92.mp3","ms":4898,"text":"اجلسْ على ضفّته، وانظُرْ إلى الماء وهو يجري بهدوء.","in":["lang"],"pause_s":{"lang":13}},{"id":"st08","art":"stille","in":["lang"],"dauer_s":{"lang":65.4}},{"id":"s033","art":"sprache","datei":"ro/33.b3bb6cda.mp3","ms":2708,"text":"ثم عُدْ إلى مكانك تحت الشمس.","in":["lang"],"pause_s":{"lang":9.5}},{"id":"s034","art":"sprache","datei":"ro/34.d148c606.mp3","ms":4685,"text":"كلُّ شيءٍ هنا هادئ. لديك متّسعٌ من الوقت.","in":["lang"],"pause_s":{"lang":9.5}},{"id":"st09","art":"stille","in":["lang"],"dauer_s":{"lang":65.4}}]},{"id":"merken","segmente":[{"id":"s035","art":"sprache","datei":"ro/35.c8061df3.mp3","ms":6533,"text":"احفظْ هذا المكان في ذاكرتك. الألوان، والأصوات، والهواء.","in":["kurz","normal","lang"],"pause_s":{"kurz":3,"normal":5,"lang":8}},{"id":"s036","art":"sprache","datei":"ro/36.08738f30.mp3","ms":4209,"text":"يمكنك أن تعود إلى هنا في خيالك، متى شئت.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s037","art":"sprache","datei":"ro/37.3136b75f.mp3","ms":3794,"text":"خُذْ بضعة أنفاسٍ هادئةٍ أخرى في هذا المكان.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"st10","art":"stille","in":["normal","lang"],"dauer_s":{"normal":62.2,"lang":65.4}}]},{"id":"rueckweg","segmente":[{"id":"s038","art":"sprache","datei":"ro/38.cbb92d8d.mp3","ms":2828,"text":"قُمِ الآن ببطء، وعُدْ إلى الدرب.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s039","art":"sprache","datei":"ro/39.1ec5e972.mp3","ms":5593,"text":"ومع كلّ خطوة تعود أكثر إلى هنا، إلى المكان الذي أنت فيه.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s040","art":"sprache","datei":"ro/40.804fe62a.mp3","ms":3718,"text":"اشعُرْ بجسمك، وهو مستلقٍ أو جالس.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s041","art":"sprache","datei":"ro/41.73db441f.mp3","ms":3518,"text":"خُذْ نَفَسًا أعمقَ قليلًا، وأخرِجْه.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s042","art":"sprache","datei":"ro/42.04569c86.mp3","ms":4495,"text":"حرِّكْ أصابع يديك وقدميك. ومدِّدْ جسمك.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s043","art":"sprache","datei":"ro/43.a530bb49.mp3","ms":2052,"text":"افتحْ عينيك متى شئت.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s044","art":"sprache","datei":"ro/44.e92790ee.mp3","ms":3243,"text":"وإن كنتَ مستلقيًا، فانهضْ ببطء.","in":["kurz","normal","lang"],"pause_s":{"kurz":1,"normal":2,"lang":3}},{"id":"glocke","art":"glocke","ton":"ende"}]}]}