{"format":1,"id":"ziel_klar","kurz":"zk","sprache":"ar","richtung":"rtl","titel":"توضيح الهدف","untertitel":"في أربع خطوات: الأمنية، وأفضل نتيجة، والعائق الداخلي، وخطّة «إذا... فسأفعل».","haltung":["sitzen"],"augen":"zu_oder_offen","ende":"glocke","schlaf_modus":false,"laengen":{"kurz":{"ziel_s":300},"normal":{"ziel_s":480},"lang":{"ziel_s":720}},"kb":926,"abschnitte":[{"id":"ankommen","segmente":[{"id":"s001","art":"sprache","datei":"zk/1.edddd955.mp3","ms":9227,"text":"اجلسْ براحةٍ وظهرُك مستقيم. وأغمِضْ عينيك إن شئت. ويمكنك أن تتوقّف في أي وقت.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s002","art":"sprache","datei":"zk/2.ffb5413d.mp3","ms":4320,"text":"تنفّسْ بهدوء بضع مرّات، شهيقًا وزفيرًا.","in":["kurz","normal","lang"],"pause_s":{"kurz":3,"normal":5,"lang":8}},{"id":"s003","art":"sprache","datei":"zk/3.a08b2224.mp3","ms":7519,"text":"لهذا التمرين أربع خطوات: الأمنية، وأفضل نتيجة، والعائق، والخطّة.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}}]},{"id":"wunsch","segmente":[{"id":"s004","art":"sprache","datei":"zk/4.2aada831.mp3","ms":9229,"text":"فكّرْ في أمنيةٍ للأسابيع القادمة. شيءٌ مهمٌّ لك، فيه شيءٌ من التحدّي، وتستطيع تحقيقه.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s005","art":"sprache","datei":"zk/5.fa6e06ff.mp3","ms":6447,"text":"قد تتعلّق بالعمل، أو بالمال، أو بالصحّة، أو بعلاقتك بالآخرين.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s006","art":"sprache","datei":"zk/6.0b81a440.mp3","ms":5158,"text":"إن خطرت لك أكثرُ من أمنية، فاخترِ اليوم واحدةً فقط.","in":["normal","lang"],"pause_s":{"normal":4,"lang":6.5}},{"id":"s007","art":"sprache","datei":"zk/7.0081a162.mp3","ms":7418,"text":"لخِّصْ أمنيتك في كلماتٍ قليلة. مثلًا: أدّخر كلَّ شهرٍ مبلغًا صغيرًا.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"st01","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":27,"normal":31.3,"lang":45.2}}]},{"id":"ergebnis","segmente":[{"id":"s008","art":"sprache","datei":"zk/8.5ab3917f.mp3","ms":4725,"text":"تخيّلِ الآن أنك حقّقتَها. ما أجملُ ما في ذلك؟","in":["kurz","normal","lang"],"pause_s":{"kurz":3,"normal":5,"lang":8}},{"id":"s009","art":"sprache","datei":"zk/9.c21ab8b3.mp3","ms":3714,"text":"كيف تشعر؟ ما الذي يتغيّر حينها؟","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s010","art":"sprache","datei":"zk/10.220cce87.mp3","ms":3688,"text":"تخيّلْ ذلك بتفاصيله، لبضعة أنفاس.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"st02","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":27,"normal":31.3,"lang":45.2}}]},{"id":"hindernis","segmente":[{"id":"s011","art":"sprache","datei":"zk/11.2e86c8ff.mp3","ms":6985,"text":"والآن خطوةٌ مهمّة. اسألْ نَفْسك: ما الذي في داخلي يقف في طريقي؟","in":["kurz","normal","lang"],"pause_s":{"kurz":3,"normal":5,"lang":8}},{"id":"s012","art":"sprache","datei":"zk/12.36792dac.mp3","ms":6405,"text":"لا الظروف، بل شيءٌ في داخلك. عادة، أو شعور، أو فكرة.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"s013","art":"sprache","datei":"zk/13.4e07280d.mp3","ms":7274,"text":"مثلًا: أؤجّل الأمور. أخاف من الرفض. يغلبني التعب في المساء.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"st03","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":27,"normal":31.3,"lang":45.2}},{"id":"s014","art":"sprache","datei":"zk/14.0b66025e.mp3","ms":5522,"text":"تخيّلِ الموقف الذي يظهر فيه هذا العائق. بأدقّ ما يمكن.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s015","art":"sprache","datei":"zk/15.cbc5ec5e.mp3","ms":3766,"text":"أين أنت؟ بماذا تفكّر في تلك اللحظة؟","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"st04","art":"stille","in":["normal","lang"],"dauer_s":{"normal":31.3,"lang":45.2}}]},{"id":"plan","segmente":[{"id":"s016","art":"sprache","datei":"zk/16.75a07c66.mp3","ms":8174,"text":"الآن تضع خطّةً من جزأين، على هذا النحو: إذا ظهر العائق، فسأفعل شيئًا محدّدًا.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s017","art":"sprache","datei":"zk/17.32ead90a.mp3","ms":7324,"text":"مثلًا: إذا غلبني التعب في المساء، فسأبدأ رغم ذلك، ولو لخمس دقائق.","in":["kurz","normal","lang"],"pause_s":{"kurz":3,"normal":5,"lang":8}},{"id":"s018","art":"sprache","datei":"zk/18.0c9afbd9.mp3","ms":4946,"text":"أو: إذا خفتُ من الرفض، فسأرسل الرسالة رغم ذلك.","in":["normal","lang"],"pause_s":{"normal":5,"lang":8}},{"id":"s019","art":"sprache","datei":"zk/19.1099a79a.mp3","ms":5189,"text":"ضعِ الآن خطّتك أنت: إذا حدث كذا، فسأفعل كذا.","in":["kurz","normal","lang"],"pause_s":{"kurz":6,"normal":10,"lang":16}},{"id":"st05","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":27,"normal":31.3,"lang":45.2}},{"id":"s020","art":"sprache","datei":"zk/20.fc7355ef.mp3","ms":4010,"text":"قُلْ خطّتك في داخلك مرّةً واحدة، ببطء.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s021","art":"sprache","datei":"zk/21.41abb882.mp3","ms":6287,"text":"ثم عِشْها في خيالك. يظهر العائق. فتفعل ما قرّرتَه.","in":["normal","lang"],"pause_s":{"normal":10,"lang":16}},{"id":"st06","art":"stille","in":["lang"],"dauer_s":{"lang":45.2}}]},{"id":"erster_schritt","segmente":[{"id":"s022","art":"sprache","datei":"zk/22.5198b616.mp3","ms":4716,"text":"ما الخطوة الأولى تمامًا؟ متى وأين ستقوم بها؟","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s023","art":"sprache","datei":"zk/23.3df9f7cc.mp3","ms":7305,"text":"تخيّلْ بدقّة كيف تخطو هذه الخطوة. لا تتخيّلِ النجاح، بل الفعل نفسه.","in":["lang"],"pause_s":{"lang":16}},{"id":"st07","art":"stille","in":["normal","lang"],"dauer_s":{"normal":31.3,"lang":45.2}}]},{"id":"rueckkehr","segmente":[{"id":"s024","art":"sprache","datei":"zk/24.7ea1147c.mp3","ms":8308,"text":"هذا التمرين لا يُغني عن العمل. لكنه قد يساعدك على التخطيط بوضوح، وعلى الاستمرار.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s025","art":"sprache","datei":"zk/25.604554af.mp3","ms":4737,"text":"إن شئت، فاكتبْ أمنيتك وخطّتك بعد التمرين مباشرة.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s026","art":"sprache","datei":"zk/26.850e6ee3.mp3","ms":4021,"text":"خُذْ نَفَسًا عميقًا وأخرِجْه، ثم افتحْ عينيك.","in":["kurz","normal","lang"],"pause_s":{"kurz":1,"normal":2,"lang":3}},{"id":"glocke","art":"glocke","ton":"ende"}]}]}