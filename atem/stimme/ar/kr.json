{"format":1,"id":"koerperreise","kurz":"kr","sprache":"ar","richtung":"rtl","titel":"رحلةٌ عبر الجسم في الاستلقاء","untertitel":"التنقّل بالانتباه ببطء في أنحاء الجسم، من القدمين حتى الرأس.","haltung":["liegen","im_bett"],"augen":"zu_oder_offen","ende":"glocke","schlaf_modus":true,"laengen":{"kurz":{"ziel_s":300},"normal":{"ziel_s":720},"lang":{"ziel_s":1500}},"kb":1443,"abschnitte":[{"id":"ankommen","segmente":[{"id":"s001","art":"sprache","datei":"kr/1.18ede810.mp3","ms":7777,"text":"استلقِ براحةٍ على ظهرك. قد تساعدك وسادةٌ تحت رأسك، وأخرى تحت ركبتيك.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s002","art":"sprache","datei":"kr/2.1ca70c57.mp3","ms":3368,"text":"ذراعاك مسترخيتان إلى جانب جسمك.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s003","art":"sprache","datei":"kr/3.734bd056.mp3","ms":6176,"text":"أغمِضْ عينيك إن شئت. وإبقاؤهما مفتوحتين لا بأس به أيضًا.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s004","art":"sprache","datei":"kr/4.91fb3dc2.mp3","ms":8235,"text":"يمكنك أن تتوقّف في أي وقت. ويمكنك أن تتخطّى أيَّ موضعٍ لا تشعر فيه بالارتياح.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s005","art":"sprache","datei":"kr/5.09d7a71f.mp3","ms":6930,"text":"في هذا التمرين لا تحتاج إلى تغيير شيء. أنت فقط تشعر بما هو موجود.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s006","art":"sprache","datei":"kr/6.63b867a1.mp3","ms":4950,"text":"وحتى إن لم تشعر بشيءٍ في موضعٍ ما، فلا بأس بذلك.","in":["normal","lang"],"pause_s":{"normal":3,"lang":5}},{"id":"s007","art":"sprache","datei":"kr/7.6cba9d68.mp3","ms":4111,"text":"خُذْ وقتك. لا يوجد ما يجب تحقيقه.","in":["lang"],"pause_s":{"lang":6.5}},{"id":"s008","art":"sprache","datei":"kr/8.c890c271.mp3","ms":5036,"text":"اشعُرْ أولًا بتنفّسك. كيف يدخل ويخرج وحدَه.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"s009","art":"sprache","datei":"kr/9.3bcf43d9.mp3","ms":10410,"text":"واشعُرْ بالمواضع التي يرتكز عليها جسمك: الكعبان، والساقان، والحوض، والظهر، ومؤخّرة الرأس.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"s010","art":"sprache","datei":"kr/10.07ec20a5.mp3","ms":2251,"text":"دَعْ جسمك يثقل تمامًا.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"st01","art":"stille","in":["normal","lang"],"dauer_s":{"normal":37.3,"lang":87.5}}]},{"id":"fuesse","segmente":[{"id":"s011","art":"sprache","datei":"kr/11.c67e267d.mp3","ms":3181,"text":"انتقلْ بانتباهك نزولًا إلى قدميك.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s012","art":"sprache","datei":"kr/12.3aa66934.mp3","ms":4726,"text":"إلى أصابع القدمين، وباطن القدمين، والكعبين.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s013","art":"sprache","datei":"kr/13.ec1328aa.mp3","ms":6763,"text":"ربما تشعر بدفءٍ أو برودة، أو بوخزٍ خفيف، أو بملامسة الغطاء.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"s014","art":"sprache","datei":"kr/14.9f4188be.mp3","ms":3625,"text":"اشعُرِ الآن بظاهر القدمين وبالكاحلين.","in":["lang"],"pause_s":{"lang":13}},{"id":"s015","art":"sprache","datei":"kr/15.63af68a5.mp3","ms":7401,"text":"إن شئت، تخيّلْ أن النَّفَسَ ينساب نزولًا حتى قدميك. ثم يخرج من جديد.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"st02","art":"stille","in":["lang"],"dauer_s":{"lang":87.5}}]},{"id":"beine","segmente":[{"id":"s016","art":"sprache","datei":"kr/16.6acc14c7.mp3","ms":4320,"text":"انتقلِ الآن إلى الساقين، من الخلف ومن الأمام.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"s017","art":"sprache","datei":"kr/17.06c25bdb.mp3","ms":1194,"text":"إلى الركبتين.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s018","art":"sprache","datei":"kr/18.a5997401.mp3","ms":6127,"text":"ثم إلى الفخذين. من الأمام والخلف، ومن الداخل والخارج.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"s019","art":"sprache","datei":"kr/19.865c36f4.mp3","ms":7519,"text":"اشعُرْ بساقك اليمنى. ثم باليسرى. ربما تشعر بأنهما مختلفتان.","in":["lang"],"pause_s":{"lang":13}},{"id":"s020","art":"sprache","datei":"kr/20.5e3ea441.mp3","ms":5286,"text":"اشعُرِ الآن بساقيك كاملتين، من القدمين حتى الوركين.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"st03","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":32.1,"normal":37.3,"lang":87.5}}]},{"id":"rumpf","segmente":[{"id":"s021","art":"sprache","datei":"kr/21.74602a6b.mp3","ms":2135,"text":"تابِعْ إلى الحوض والأرداف.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"s022","art":"sprache","datei":"kr/22.c6eda320.mp3","ms":5909,"text":"إلى البطن. ربما تشعر به يرتفع وينخفض مع التنفّس.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s023","art":"sprache","datei":"kr/23.d25b2018.mp3","ms":1375,"text":"إلى أسفل الظهر.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s024","art":"sprache","datei":"kr/24.79f0ae0f.mp3","ms":3327,"text":"إلى أعلى الظهر، بين لوحَي الكتفين.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"s025","art":"sprache","datei":"kr/25.2a259525.mp3","ms":3868,"text":"إلى الصدر. هنا أيضًا يتحرّك النَّفَس.","in":["normal","lang"],"pause_s":{"normal":8,"lang":13}},{"id":"s026","art":"sprache","datei":"kr/26.2f33d8f2.mp3","ms":8042,"text":"إذا شعرتَ بتوتّرٍ في مكانٍ ما، فتنفّسْ نحوه بلطف. لا حاجة إلى أن تُزيله.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"st04","art":"stille","in":["normal","lang"],"dauer_s":{"normal":37.3,"lang":87.5}}]},{"id":"arme","segmente":[{"id":"s027","art":"sprache","datei":"kr/27.d6b5eb65.mp3","ms":7830,"text":"وجِّهِ انتباهك الآن إلى يديك. إلى أطراف الأصابع، وراحتَي اليدين، وظاهرِهما.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s028","art":"sprache","datei":"kr/28.bdd16303.mp3","ms":1931,"text":"إلى الرسغين والساعدين.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s029","art":"sprache","datei":"kr/29.f0bca5bd.mp3","ms":2560,"text":"إلى المرفقين وأعلى الذراعين.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s030","art":"sprache","datei":"kr/30.8124e1ff.mp3","ms":6837,"text":"ثم إلى الكتفين. وإن أرادتا أن تنزلا قليلًا، فدَعْهما تنزلان.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s031","art":"sprache","datei":"kr/31.29ea53b1.mp3","ms":5022,"text":"اشعُرْ بذراعيك معًا، من أطراف الأصابع حتى الكتفين.","in":["lang"],"pause_s":{"lang":13}},{"id":"st05","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":32.1,"normal":37.3,"lang":87.5}}]},{"id":"kopf","segmente":[{"id":"s032","art":"sprache","datei":"kr/32.c62284ed.mp3","ms":4336,"text":"اشعُرِ الآن برقبتك، من الخلف ومن الأمام.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s033","art":"sprache","datei":"kr/33.c86b7d3e.mp3","ms":5305,"text":"بالفكّ. ربما تسمح لأسنانك أن تنفرج قليلًا.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s034","art":"sprache","datei":"kr/34.78120cba.mp3","ms":3398,"text":"بالشفتين، والخدّين، والأنف.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s035","art":"sprache","datei":"kr/35.1cde14de.mp3","ms":4628,"text":"اشعُرْ بالهواء وهو يدخل من الأنف، ويخرج منه.","in":["lang"],"pause_s":{"lang":13}},{"id":"s036","art":"sprache","datei":"kr/36.d8497442.mp3","ms":1871,"text":"بالعينين والجفنين.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s037","art":"sprache","datei":"kr/37.5a0f64e8.mp3","ms":1777,"text":"بالجبهة والصُّدغين.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s038","art":"sprache","datei":"kr/38.136265be.mp3","ms":2650,"text":"وبالرأس كلِّه، حتى قمّته.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"st06","art":"stille","in":["normal","lang"],"dauer_s":{"normal":37.3,"lang":87.5}}]},{"id":"ganz","segmente":[{"id":"s039","art":"sprache","datei":"kr/39.25ee88b8.mp3","ms":6382,"text":"اشعُرِ الآن بجسمك كلِّه دفعةً واحدة. من القدمين حتى الرأس.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"s040","art":"sprache","datei":"kr/40.917269d8.mp3","ms":3609,"text":"كيف يستلقي. وكيف يتنفّس.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"s041","art":"sprache","datei":"kr/41.d2f00ed8.mp3","ms":2843,"text":"كُنْ هنا فقط، كما أنت الآن.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"st07","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":32.1,"normal":37.3,"lang":87.5}},{"id":"s042","art":"sprache","datei":"kr/42.020ea549.mp3","ms":6267,"text":"إن شردت أفكارك، فلا بأس. عُدْ ببساطة إلى الإحساس بجسمك.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"st08","art":"stille","in":["normal","lang"],"dauer_s":{"normal":37.3,"lang":87.5}},{"id":"s043","art":"sprache","datei":"kr/43.0cb75270.mp3","ms":4306,"text":"النَّفَسُ ينساب في جسمك كلِّه، وحدَه تمامًا.","in":["lang"],"pause_s":{"lang":9.5}},{"id":"st09","art":"stille","in":["lang"],"dauer_s":{"lang":87.5}}]},{"id":"rueckkehr","segmente":[{"id":"s044","art":"sprache","datei":"kr/44.e92227df.mp3","ms":4303,"text":"يقترب التمرين الآن، بهدوء، من نهايته.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s045","art":"sprache","datei":"kr/45.16a20b75.mp3","ms":6400,"text":"إذا أردتَ أن تنام، فابقَ كما أنت. لم يعد عليك أن تفعل شيئًا.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5},"modus":"wach"},{"id":"s046","art":"sprache","datei":"kr/46.1b02e940.mp3","ms":5764,"text":"وإذا أردتَ أن تنهض، فخُذْ نَفَسًا أعمقَ قليلًا، وأخرِجْه.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5},"modus":"wach"},{"id":"s047","art":"sprache","datei":"kr/47.f65a5558.mp3","ms":5155,"text":"حرِّكْ أصابع يديك وقدميك. ومدِّدْ جسمك إن شئت.","in":["kurz","normal","lang"],"pause_s":{"kurz":3,"normal":5,"lang":8},"modus":"wach"},{"id":"s048","art":"sprache","datei":"kr/48.4182d273.mp3","ms":2052,"text":"افتحْ عينيك متى شئت.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5},"modus":"wach"},{"id":"s049","art":"sprache","datei":"kr/49.aa17d49e.mp3","ms":3577,"text":"انقلِبْ على جنبك، ثم انهضْ ببطء.","in":["kurz","normal","lang"],"pause_s":{"kurz":1,"normal":2,"lang":3},"modus":"wach"},{"id":"s050","art":"sprache","datei":"kr/50.5a0dd874.mp3","ms":5459,"text":"ابقَ مستلقيًا كما أنت. لم يعد عليك أن تفعل شيئًا.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5},"pegel_db":-5,"modus":"schlaf"},{"id":"s051","art":"sprache","datei":"kr/51.e75f444f.mp3","ms":4803,"text":"سأصمتُ الآن. استرِحْ. ليلةً هانئة.","in":["kurz","normal","lang"],"pause_s":{"kurz":1,"normal":2,"lang":3},"pegel_db":-7,"modus":"schlaf"},{"id":"st10","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":60,"normal":120,"lang":180},"ende_stille":true,"modus":"schlaf"},{"id":"glocke","art":"glocke","ton":"ende","modus":"wach"}]}]}