{"format":1,"id":"freundlich_mit_mir","kurz":"fm","sprache":"ar","richtung":"rtl","titel":"اللطف مع نفسي","untertitel":"في لحظةٍ صعبة، أن تخاطب نفسك بلطف، كما تخاطب صديقًا عزيزًا.","haltung":["sitzen","liegen"],"augen":"zu_oder_offen","ende":"glocke","schlaf_modus":false,"laengen":{"kurz":{"ziel_s":180},"normal":{"ziel_s":600},"lang":{"ziel_s":900}},"kb":947,"abschnitte":[{"id":"ankommen","segmente":[{"id":"s001","art":"sprache","datei":"fm/1.884a3d95.mp3","ms":2372,"text":"اجلسْ براحة، أو استلقِ.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s002","art":"sprache","datei":"fm/2.9e826ed0.mp3","ms":5503,"text":"أغمِضْ عينيك إن شئت. ويمكنك أن تتوقّف في أي وقت.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s003","art":"sprache","datei":"fm/3.d2811688.mp3","ms":5322,"text":"اشعُرْ بجلستك أو استلقائك. ودَعْ كتفيك تنزلان.","in":["normal","lang"],"pause_s":{"normal":4,"lang":6.5}},{"id":"s004","art":"sprache","datei":"fm/4.a27192aa.mp3","ms":4413,"text":"تنفّسْ بهدوء بضع مرّات، شهيقًا وزفيرًا.","in":["kurz","normal","lang"],"pause_s":{"kurz":3,"normal":5,"lang":8}}]},{"id":"situation","segmente":[{"id":"s005","art":"sprache","datei":"fm/5.25a831fe.mp3","ms":5918,"text":"فكّرْ في موقفٍ يشغلك هذه الأيام. شيءٌ صعبٌ بعض الشيء.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s006","art":"sprache","datei":"fm/6.85cbecc9.mp3","ms":4247,"text":"لا تخترِ الأصعب. يكفي شيءٌ متوسّط.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s007","art":"sprache","datei":"fm/7.62f4bf6f.mp3","ms":5387,"text":"تخيّلِ الموقف قليلًا. أين أنت؟ ماذا حدث؟","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s008","art":"sprache","datei":"fm/8.f00931d9.mp3","ms":7002,"text":"لاحِظْ أين تشعر به في جسمك. ربما في البطن، أو في الصدر، أو في الحلق.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"st01","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":27.9,"normal":53.2,"lang":60.7}},{"id":"s009","art":"sprache","datei":"fm/9.83a1ae63.mp3","ms":6689,"text":"إذا صار الأمر أثقلَ من اللازم، فافتحْ عينيك، واشعُرْ بقدميك على الأرض.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}}]},{"id":"bemerken","segmente":[{"id":"s010","art":"sprache","datei":"fm/10.65414e37.mp3","ms":3558,"text":"قُلْ في داخلك الآن: هذه لحظةٌ صعبة.","in":["kurz","normal","lang"],"pause_s":{"kurz":3,"normal":5,"lang":8}},{"id":"s011","art":"sprache","datei":"fm/11.05e85413.mp3","ms":5502,"text":"أو بكلماتك أنت: هذا يؤلمني. هذا يضغط عليّ.","in":["normal","lang"],"pause_s":{"normal":5,"lang":8}}]},{"id":"nicht_allein","segmente":[{"id":"s012","art":"sprache","datei":"fm/12.0e2e990d.mp3","ms":6661,"text":"ثم: كثيرٌ من الناس يمرّون بمثل هذا. لستُ وحدي في هذا.","in":["kurz","normal","lang"],"pause_s":{"kurz":3.5,"normal":6,"lang":9.5}},{"id":"s013","art":"sprache","datei":"fm/13.0c9bbf01.mp3","ms":4783,"text":"الآخرون يشعرون بشيءٍ مشابه، في موقفٍ كهذا.","in":["normal","lang"],"pause_s":{"normal":5,"lang":8}},{"id":"st02","art":"stille","in":["normal","lang"],"dauer_s":{"normal":53.2,"lang":60.7}}]},{"id":"freundlich","segmente":[{"id":"s014","art":"sprache","datei":"fm/14.470d502f.mp3","ms":5591,"text":"إن شئت، ضعْ يدك على قلبك، أو على بطنك، أو على خدّك.","in":["kurz","normal","lang"],"pause_s":{"kurz":3,"normal":5,"lang":8}},{"id":"s015","art":"sprache","datei":"fm/15.a82cd7d2.mp3","ms":1548,"text":"اشعُرْ بدفء يدك.","in":["normal","lang"],"pause_s":{"normal":5,"lang":8}},{"id":"s016","art":"sprache","datei":"fm/16.be7c7ccb.mp3","ms":6819,"text":"واسألْ نَفْسك: ماذا كنتُ سأقول لصديقٍ عزيز، يمرّ بما أمرّ به الآن؟","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"s017","art":"sprache","datei":"fm/17.f020a260.mp3","ms":7179,"text":"ربما: أنت تبذل جهدك. أو: من الطبيعي أن يكون هذا صعبًا الآن.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s018","art":"sprache","datei":"fm/18.26ef2c09.mp3","ms":4746,"text":"قُلْ هذه الكلمات لنَفْسك الآن. بنبرةٍ دافئة.","in":["kurz","normal","lang"],"pause_s":{"kurz":5,"normal":8,"lang":13}},{"id":"st03","art":"stille","in":["kurz","normal","lang"],"dauer_s":{"kurz":27.9,"normal":53.2,"lang":60.7}},{"id":"s019","art":"sprache","datei":"fm/19.6f91f116.mp3","ms":7282,"text":"ليس ضروريًّا أن تشعر بالراحة فورًا. المهمّ أن تتّجه إلى نَفْسك بلطف.","in":["normal","lang"],"pause_s":{"normal":5,"lang":8}},{"id":"s020","art":"sprache","datei":"fm/20.16c0ba5d.mp3","ms":4430,"text":"كرِّرِ الكلمات كلّما شئت. ببطءٍ ولطف.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"st04","art":"stille","in":["normal","lang"],"dauer_s":{"normal":53.2,"lang":60.7}},{"id":"s021","art":"sprache","datei":"fm/21.d9fc831d.mp3","ms":7525,"text":"لاحِظْ هل يتغيّر شيءٌ في جسمك. أو لا يتغيّر. كلا الأمرين لا بأس به.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"st05","art":"stille","in":["normal","lang"],"dauer_s":{"normal":53.2,"lang":60.7}},{"id":"s022","art":"sprache","datei":"fm/22.1a904298.mp3","ms":7933,"text":"إن كان صعبًا عليك أن تكون لطيفًا مع نَفْسك، فلا بأس. كثيرون يعرفون هذا الشعور.","in":["lang"],"pause_s":{"lang":8}},{"id":"s023","art":"sprache","datei":"fm/23.136dfecd.mp3","ms":5032,"text":"عندها تخيّلْ أن شخصًا يحبّك، يقول لك هذه الكلمات.","in":["lang"],"pause_s":{"lang":13}},{"id":"st06","art":"stille","in":["lang"],"dauer_s":{"lang":60.7}}]},{"id":"satz","segmente":[{"id":"s024","art":"sprache","datei":"fm/24.90b0f70a.mp3","ms":7193,"text":"اخترْ جملةً قصيرة تأخذها معك. جملةً صادقة، لا مبالغة فيها.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s025","art":"sprache","datei":"fm/25.fa062a65.mp3","ms":4827,"text":"مثلًا: مسموحٌ لي أن أخطئ، وأن أتعلّم من أخطائي.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"s026","art":"sprache","datei":"fm/26.15f4d8da.mp3","ms":2267,"text":"أو: أنا سندٌ لنَفْسي.","in":["normal","lang"],"pause_s":{"normal":6,"lang":9.5}},{"id":"st07","art":"stille","in":["normal","lang"],"dauer_s":{"normal":53.2,"lang":60.7}},{"id":"s027","art":"sprache","datei":"fm/27.b0b85024.mp3","ms":4912,"text":"ردِّدْ جملتك بضع مرّاتٍ أخرى، مع إيقاع تنفّسك.","in":["lang"],"pause_s":{"lang":9.5}},{"id":"st08","art":"stille","in":["lang"],"dauer_s":{"lang":60.7}}]},{"id":"rueckkehr","segmente":[{"id":"s028","art":"sprache","datei":"fm/28.14a35340.mp3","ms":1702,"text":"اتركِ الموقف الآن.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s029","art":"sprache","datei":"fm/29.7b44c3b9.mp3","ms":4867,"text":"اشعُرْ من جديد بتنفّسك، وبجلستك أو استلقائك.","in":["kurz","normal","lang"],"pause_s":{"kurz":2.5,"normal":4,"lang":6.5}},{"id":"s030","art":"sprache","datei":"fm/30.b3f68d3f.mp3","ms":3147,"text":"خُذْ نَفَسًا عميقًا، ثم أخرِجْه.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s031","art":"sprache","datei":"fm/31.f758ba6e.mp3","ms":2050,"text":"افتحْ عينيك متى شئت.","in":["kurz","normal","lang"],"pause_s":{"kurz":2,"normal":3,"lang":5}},{"id":"s032","art":"sprache","datei":"fm/32.470102af.mp3","ms":3241,"text":"وإن كنتَ مستلقيًا، فانهضْ ببطء.","in":["kurz","normal","lang"],"pause_s":{"kurz":1,"normal":2,"lang":3}},{"id":"glocke","art":"glocke","ton":"ende"}]}]}